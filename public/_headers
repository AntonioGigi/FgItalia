# Intestazioni di sicurezza (Cloudflare). La Content Security Policy completa è in ogni pagina,
# generata da Astro con le impronte degli script: vedi astro.config.mjs

/*
  # solo HTTPS per un anno (non si estende ai sottodomini, per non toccare la posta di Aruba)
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'; object-src 'none'; base-uri 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=()

# Pagine con dati personali: mai in cache e mai indicizzate; isolate da altre finestre
# (non /admin/ e /cms-accesso/, che si parlano tra finestre)
/account/*
  Cache-Control: no-store
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: noindex, nofollow

/gestione-ordini/*
  Cache-Control: no-store
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: noindex, nofollow

/ordine/*
  Cache-Control: no-store
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: noindex, nofollow
