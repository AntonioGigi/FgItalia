---
import { promozioniAttive } from '../lib/promozioni';
import { formatoData } from '../lib/sito';

// Striscia in cima a ogni pagina con le promozioni attive che hanno "banner" acceso
const promozioni = (await promozioniAttive()).filter((p) => p.data.banner);
const prima = promozioni[0];
---

{
  prima && (
    <a class="banner-offerte" href="/offerte/">
      <span class="banner-offerte__etichetta">Offerta</span>
      <strong>{prima.data.titolo}</strong>
      {prima.data.al && <span class="banner-offerte__fino">fino al {formatoData.format(prima.data.al)}</span>}
      {promozioni.length > 1 && <span class="banner-offerte__fino">e altre {promozioni.length - 1}</span>}
      <span class="banner-offerte__vai">Scopri le offerte →</span>
    </a>
  )
}

<style>
  .banner-offerte {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px 12px;
    padding: 10px 16px;
    background: #d92d20;
    color: var(--bianco);
    font-size: 0.95rem;
    text-align: center;
    text-decoration: none;
  }

  .banner-offerte:hover {
    background: #b42318;
    color: var(--bianco);
  }

  .banner-offerte__etichetta {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--accento);
    color: var(--blu-900);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .banner-offerte__fino {
    opacity: 0.9;
  }

  .banner-offerte__vai {
    font-weight: 700;
    text-decoration: underline;
  }
</style>
