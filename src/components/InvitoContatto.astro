---
import Icona from './Icona.astro';
import { sito, soloCifre, linkWhatsApp } from '../lib/sito';

interface Props {
  titolo?: string;
  testo?: string;
}

const {
  titolo = 'Cerchi un’apparecchiatura specifica?',
  testo = 'Raccontaci di cosa hai bisogno: ti aiutiamo a scegliere il prodotto giusto e ti inviamo un preventivo senza impegno.',
} = Astro.props;
const whatsapp = linkWhatsApp('Buongiorno, vorrei informazioni su un prodotto.');
---

<section class="contenitore">
  <div class="invito appare">
    <div>
      <h2>{titolo}</h2>
      <p>{testo}</p>
    </div>
    <div class="invito__azioni">
      <a class="pulsante pulsante--primario" href="/contatti/#preventivo">
        Richiedi un preventivo <Icona nome="freccia" />
      </a>
      {
        whatsapp && (
          <a class="pulsante pulsante--whatsapp" href={whatsapp} target="_blank" rel="noopener">
            <Icona nome="whatsapp" /> WhatsApp
          </a>
        )
      }
      {
        !whatsapp && sito.telefono && (
          <a class="pulsante pulsante--chiaro" href={`tel:${soloCifre(sito.telefono)}`}>
            <Icona nome="telefono" /> {sito.telefono}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  section {
    margin-block: clamp(56px, 9vw, 112px);
  }

  .invito {
    position: relative;
    display: grid;
    grid-template-columns: 1.4fr auto;
    align-items: center;
    gap: 32px;
    padding: clamp(32px, 6vw, 64px);
    border-radius: 28px;
    background:
      radial-gradient(circle at 100% 0%, rgb(96 152 248 / 0.35), transparent 50%),
      linear-gradient(135deg, var(--blu-800), var(--blu-900));
    color: rgb(255 255 255 / 0.8);
    overflow: hidden;
  }

  .invito h2 {
    color: var(--bianco);
  }

  .invito p {
    margin: 0;
    font-size: 1.1rem;
    max-width: 52ch;
  }

  .invito__azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 820px) {
    .invito {
      grid-template-columns: 1fr;
    }
  }
</style>
