---
import Icona from './Icona.astro';

interface Props {
  titolo: string;
}

const { titolo } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).toString();
const facebook = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
const whatsapp = `https://wa.me/?text=${encodeURIComponent(`${titolo} ${url}`)}`;
---

<div class="condividi" data-condividi data-url={url} data-titolo={titolo}>
  <span class="condividi__etichetta">Condividi</span>
  <a href={whatsapp} target="_blank" rel="noopener" aria-label="Condividi su WhatsApp"><Icona nome="whatsapp" dimensione={20} /></a>
  <a href={facebook} target="_blank" rel="noopener" aria-label="Condividi su Facebook"><Icona nome="facebook" dimensione={20} /></a>
  <button type="button" data-copia aria-label="Copia il link">
    <Icona nome="link" dimensione={20} />
  </button>
  <span class="condividi__avviso" role="status" data-avviso></span>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-condividi]').forEach((box) => {
    const avviso = box.querySelector<HTMLElement>('[data-avviso]');
    box.querySelector('[data-copia]')?.addEventListener('click', async () => {
      const { url = location.href, titolo = document.title } = box.dataset;
      // Su smartphone apre il menu di condivisione nativo (Instagram, WhatsApp, ...)
      if (navigator.share && matchMedia('(pointer: coarse)').matches) {
        try {
          await navigator.share({ title: titolo, url });
          return;
        } catch {
          /* condivisione annullata: copio il link */
        }
      }
      try {
        await navigator.clipboard.writeText(url);
        if (avviso) avviso.textContent = 'Link copiato!';
      } catch {
        if (avviso) avviso.textContent = url;
      }
      setTimeout(() => avviso && (avviso.textContent = ''), 2500);
    });
  });
</script>

<style>
  .condividi {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .condividi__etichetta {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--grigio-500);
    margin-right: 4px;
  }

  .condividi a,
  .condividi button {
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--grigio-200);
    background: var(--bianco);
    color: var(--blu-800);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .condividi a:hover,
  .condividi button:hover {
    background: var(--blu-800);
    border-color: var(--blu-800);
    color: var(--bianco);
  }

  .condividi__avviso {
    font-size: 0.85rem;
    color: var(--verde-scuro);
    font-weight: 600;
  }
</style>
