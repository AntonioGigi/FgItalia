---
/**
 * Simulatore interattivo dello schermo della Winback BACK4 (solo dimostrazione).
 * Dati in src/lib/back4.ts. Nessuno stile inline: la Content Security Policy li bloccherebbe,
 * i colori dinamici si impostano da script con le variabili CSS.
 */
import { CORRENTI, CONFIGURAZIONI, FASI, STRATI, ZONE } from '../lib/back4';
---

<section class="sim" id="simulatore" aria-labelledby="sim-titolo" data-sim>
  <div class="contenitore">
    <div class="sim__testa">
      <span class="sopratitolo">Prova lo schermo</span>
      <h2 id="sim-titolo">Simulatore BACK4</h2>
      <p class="testo-intro">
        Tocca lo schermo come sul dispositivo vero: scegli tra <strong>Academy</strong> e <strong>Expert</strong>, attiva le correnti,
        regola potenza e tempi, prova i manipoli, i bracciali e le configurazioni a tre zone.
      </p>
    </div>

    <div class="sim__griglia">
      <!-- ——— il dispositivo ——— -->
      <div class="dispositivo">
        <div class="dispositivo__marchio" aria-hidden="true"><small>WINBACK</small>BACK<span>4</span></div>

        <div class="schermo" data-schermo>
          <!-- schermata iniziale -->
          <div class="vista vista--home" data-vista="home">
            <div class="onde" aria-hidden="true"><span></span><span></span><span></span></div>
            <div class="home__scelte">
              <button type="button" class="home__scelta" data-vai="academy">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4 2 9l10 5 10-5-10-5zm-6 7.5V16c0 1.7 2.7 3 6 3s6-1.3 6-3v-4.5" /></svg>
                <strong>ACADEMY</strong><small>MODE</small>
              </button>
              <button type="button" class="home__scelta" data-vai="expert">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3v8m0 4v6M12 3v4m0 4v10M18 3v10m0 4v4M4 13h4M10 9h4M16 15h4" /></svg>
                <strong>EXPERT</strong><small>MODE</small>
              </button>
            </div>
          </div>

          <!-- modalità Academy: zona → fase → programma -->
          <div class="vista vista--academy" data-vista="academy" hidden>
            <div class="barra-schermo">
              <button type="button" class="barra-schermo__home" data-vai="home" aria-label="Torna alla schermata iniziale">⌂</button>
              <strong>ACADEMY</strong>
              <span class="barra-schermo__passo" data-passo-academy>1/3 · Zona del corpo</span>
            </div>
            <div class="academy" data-academy-passo="1">
              <p class="academy__domanda">Quale zona vuoi trattare?</p>
              <div class="academy__scelte academy__scelte--zone">
                {ZONE.map((z) => (
                  <button type="button" data-zona={z.id}>
                    {z.nome}
                  </button>
                ))}
              </div>
            </div>
            <div class="academy" data-academy-passo="2" hidden>
              <p class="academy__domanda">In che fase è il problema?</p>
              <div class="academy__scelte">
                {FASI.map((f) => (
                  <button type="button" data-fase={f.id}>
                    <strong>{f.nome}</strong>
                    <small>{f.descrizione}</small>
                  </button>
                ))}
              </div>
            </div>
            <div class="academy" data-academy-passo="3" hidden>
              <p class="academy__domanda" data-academy-riepilogo></p>
              <ol class="academy__programma" data-academy-programma></ol>
              <div class="academy__azioni">
                <button type="button" class="tasto-schermo" data-academy-indietro>Cambia</button>
                <button type="button" class="tasto-schermo tasto-schermo--primario" data-academy-avvia>Carica il programma ▶</button>
              </div>
              <p class="academy__nota">Programma di esempio per la dimostrazione: sul dispositivo trovi la libreria di protocolli Academy.</p>
            </div>
          </div>

          <!-- modalità Expert -->
          <div class="vista vista--expert" data-vista="expert" hidden>
            <div class="barra-schermo">
              <button type="button" class="barra-schermo__home" data-vai="home" aria-label="Torna alla schermata iniziale">⌂</button>
              <div class="schede-correnti" role="group" aria-label="Correnti attive">
                {CORRENTI.map((c) => (
                  <button type="button" class="scheda-corrente" data-attiva={c.id} aria-pressed="false">
                    {c.nome}
                  </button>
                ))}
              </div>
              <button type="button" class="scheda-corrente scheda-corrente--swap" data-swap aria-pressed="false" title="Alternanza tra RET e Hi-TENS">
                SWAP
              </button>
              <span class="barra-schermo__wifi" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M2 9a15 15 0 0 1 20 0M5 12.5a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0" /><circle cx="12" cy="19.5" r="1.2" /></svg>
              </span>
            </div>

            <div class="canali">
              {CORRENTI.map((c) => (
                <div class="canale" data-canale={c.id}>
                  <div class="canale__modi" role="group" aria-label={`Modalità ${c.nome}`}>
                    {c.modalita.map((m, i) => (
                      <button type="button" data-modo={m.id} aria-pressed={i === 0 ? 'true' : 'false'}>
                        {m.nome}
                      </button>
                    ))}
                  </div>
                  <div class="canale__frequenza" data-frequenza />
                  <div class="canale__potenza">
                    <output data-valore>0%</output>
                    <div class="cursore">
                      <div class="cursore__traccia" aria-hidden="true">
                        <div class="cursore__livello" data-livello />
                      </div>
                      <input
                        type="range"
                        min="0"
                        max="100"
                        step="1"
                        value="0"
                        data-intensita
                        aria-label={`Potenza ${c.nome}`}
                        class="cursore__input"
                      />
                    </div>
                    <div class="canale__piu-meno">
                      <button type="button" data-passo="-1" aria-label={`Diminuisci potenza ${c.nome}`}>
                        −
                      </button>
                      <button type="button" data-passo="1" aria-label={`Aumenta potenza ${c.nome}`}>
                        +
                      </button>
                    </div>
                  </div>
                  <div class="canale__tempo">
                    <button type="button" data-tempo="-1" aria-label={`Meno tempo ${c.nome}`}>
                      ‹
                    </button>
                    <span data-durata>00:00</span>
                    <button type="button" data-tempo="1" aria-label={`Più tempo ${c.nome}`}>
                      ›
                    </button>
                  </div>
                </div>
              ))}
            </div>

            <div class="comandi">
              <span class="comandi__motto">BETTER · FASTER · GENTLER</span>
              <div class="comandi__tasti">
                <button type="button" data-avvia aria-label="Avvia">▶</button>
                <button type="button" data-pausa aria-label="Pausa">❚❚</button>
                <button type="button" data-ferma aria-label="Ferma">■</button>
              </div>
              <div class="anello" aria-live="polite">
                <svg viewBox="0 0 40 40" aria-hidden="true">
                  <circle cx="20" cy="20" r="17" class="anello__fondo" />
                  <circle cx="20" cy="20" r="17" class="anello__avanzamento" data-anello />
                </svg>
                <span data-totale>0'</span>
              </div>
            </div>
          </div>
        </div>

        <div class="dispositivo__fondo" aria-hidden="true">
          <span class="dispositivo__simbolo"><i></i><i></i><i></i></span>
          <span class="dispositivo__accensione" data-acceso></span>
        </div>
      </div>

      <!-- ——— accessori, corpo e profondità ——— -->
      <div class="pannello-sim">
        <div class="pannello-sim__blocco">
          <h3>Manipoli e accessori</h3>
          <div class="configurazioni" role="radiogroup" aria-label="Configurazione degli accessori">
            {CONFIGURAZIONI.map((c, i) => (
              <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-configurazione={c.id}>
                {c.nome}
              </button>
            ))}
          </div>
          <p class="pannello-sim__spiega" data-spiega-configurazione></p>
          <button type="button" class="pulsante pulsante--contorno urto" data-urto>
            ⚡ Urta i due manipoli TX
          </button>
          <p class="pannello-sim__nota">Sul dispositivo vero basta far toccare i due TX per passare dall’azione muscolare (CET) a quella articolare (RET).</p>
        </div>

        <div class="pannello-sim__blocco corpo-blocco">
          <svg class="corpo" viewBox="12 0 76 110" role="img" aria-label="Posizione di manipoli ed elettrodi sul corpo" data-corpo>
            <g class="corpo__sagoma" aria-hidden="true">
              <circle cx="50" cy="9" r="6.5" />
              <rect x="46.5" y="14.5" width="7" height="5" rx="2" />
              <path d="M36 20h28c3 0 5 2 5 5l-2 26c0 2-1.5 3.5-3.5 3.5h-27C34.5 54.5 33 53 33 51l-2-26c0-3 2-5 5-5z" />
              <path d="M31 22c-3 1-4.5 3-5.2 6L21 50c-.4 2 .8 3.5 2.6 3.6 1.4.1 2.5-.8 2.9-2.1l6.2-22z" />
              <path d="M69 22c3 1 4.5 3 5.2 6L79 50c.4 2-.8 3.5-2.6 3.6-1.4.1-2.5-.8-2.9-2.1l-6.2-22z" />
              <path d="M36.5 54h12l-1 48c0 2-1.5 3-3.2 3h-2.6c-1.7 0-3-1.2-3.1-2.9z" />
              <path d="M51.5 54h12l-2.1 48.1c-.1 1.7-1.4 2.9-3.1 2.9h-2.6c-1.7 0-3.2-1-3.2-3z" />
            </g>
            <g data-zone-corpo>
              {ZONE.map((z) => <circle class="corpo__zona" cx={z.x} cy={z.y} r="3.2" data-zona-corpo={z.id} />)}
            </g>
            <g data-collegamenti></g>
            <g data-elettrodi></g>
          </svg>
          <p class="pannello-sim__nota" data-nota-corpo>Tocca una zona del corpo per spostare i manipoli.</p>
        </div>

        <div class="pannello-sim__blocco">
          <h3>Profondità d’azione</h3>
          <ul class="strati">
            {STRATI.map((s) => (
              <li data-strato={s.id}>
                <span class="strati__nome">
                  {s.nome}
                  <small>{s.dettaglio}</small>
                </span>
                <span class="strati__barra">
                  <span data-strato-livello />
                </span>
              </li>
            ))}
          </ul>
          <ul class="legenda" data-legenda></ul>
        </div>
      </div>
    </div>

    <p class="sim__avviso">
      Simulazione a scopo illustrativo, non è il software ufficiale Winback. Frequenze, modalità e accessori dalla scheda tecnica del
      dispositivo; i programmi Academy mostrati sono esempi. Il trattamento va sempre scelto da un professionista sanitario.
    </p>
  </div>
</section>

<script>
  import {
    CONFIGURAZIONI,
    CORRENTI,
    DURATA_MAX,
    FASI,
    PASSO_DURATA,
    STRATI,
    ZONE,
    corrente,
    durataSeduta,
    limita,
    modalita,
    profondita,
    programmaEsempio,
    tempo,
    type Canale,
    type IdConfigurazione,
    type IdCorrente,
    type IdFase,
    type IdZona,
  } from '../lib/back4';

  const radice = document.querySelector<HTMLElement>('[data-sim]');
  if (radice) avvia(radice);

  function avvia(radice: HTMLElement) {
    const $ = <T extends Element = HTMLElement>(s: string, base: ParentNode = radice) => base.querySelector<T>(s)!;
    const $$ = <T extends Element = HTMLElement>(s: string, base: ParentNode = radice) => [...base.querySelectorAll<T>(s)];
    const SVG = 'http://www.w3.org/2000/svg';

    // ——— stato ———
    const canali = Object.fromEntries(
      CORRENTI.map((c) => [c.id, { attivo: false, modalita: c.modalita[0].id, intensita: 0, durata: 0 } satisfies Canale]),
    ) as Record<IdCorrente, Canale>;
    canali.tens.frequenza = '25 Hz';
    const rimasto: Record<IdCorrente, number> = { cet: 0, ret: 0, tens: 0, ems: 0, mix: 0 };
    let inCorso = false;
    let inPausa = false;
    let swap = false;
    let faseSwap = 0;
    let configurazione: IdConfigurazione = 'piastra';
    let zona: IdZona = 'spalla';
    let fase: IdFase | undefined;
    let totaleIniziale = 0;
    let ultimoTick = 0;

    // ——— viste dello schermo ———
    function mostra(vista: 'home' | 'academy' | 'expert') {
      for (const v of $$('[data-vista]')) v.hidden = v.dataset.vista !== vista;
      if (vista === 'academy') passoAcademy(1);
      $('[data-acceso]').classList.toggle('acceso', vista !== 'home');
    }

    // ——— Academy ———
    function passoAcademy(n: 1 | 2 | 3) {
      for (const p of $$('[data-academy-passo]')) p.hidden = p.dataset.academyPasso !== String(n);
      $('[data-passo-academy]').textContent = ['', '1/3 · Zona del corpo', '2/3 · Fase', '3/3 · Programma'][n];
      for (const b of $$<HTMLButtonElement>('[data-zona]')) b.setAttribute('aria-pressed', String(b.dataset.zona === zona));
      if (n === 3 && fase) {
        const prog = programmaEsempio(zona, fase);
        const nomeZona = ZONE.find((z) => z.id === zona)!.nome;
        const nomeFase = FASI.find((f) => f.id === fase)!.nome;
        $('[data-academy-riepilogo]').textContent = `${nomeZona} · ${nomeFase}`;
        const lista = $('[data-academy-programma]');
        lista.replaceChildren(
          ...CORRENTI.filter((c) => prog[c.id]?.attivo).map((c) => {
            const k = prog[c.id]!;
            const li = document.createElement('li');
            li.style.setProperty('--colore', c.colore);
            const m = modalita(c.id, k.modalita);
            li.textContent = `${c.nome} ${m.nome} · ${k.frequenza ?? m.frequenze.join(' / ')} · ${k.intensita}% · ${tempo(k.durata)}`;
            return li;
          }),
        );
      }
    }

    function caricaProgramma() {
      if (!fase) return;
      ferma();
      const prog = programmaEsempio(zona, fase);
      for (const c of CORRENTI) Object.assign(canali[c.id], prog[c.id]);
      swap = false;
      configurazione = zona === 'lombare' || zona === 'dorsale' ? 'due-tx' : 'piastra';
      mostra('expert');
      aggiornaTutto();
    }

    // ——— Expert ———
    function aggiornaCanale(id: IdCorrente) {
      const c = corrente(id);
      const k = canali[id];
      const col = $(`[data-canale="${id}"]`);
      col.classList.toggle('canale--attivo', k.attivo);
      col.style.setProperty('--colore', c.colore);
      col.style.setProperty('--livello', String(k.intensita / 100));
      $(`[data-attiva="${id}"]`).setAttribute('aria-pressed', String(k.attivo));
      $(`[data-attiva="${id}"]`).style.setProperty('--colore', c.colore);
      for (const b of $$('[data-modo]', col)) b.setAttribute('aria-pressed', String(b.dataset.modo === k.modalita));
      const m = modalita(id, k.modalita);
      const freq = $('[data-frequenza]', col);
      if (id === 'tens' && k.modalita === 'manual') {
        freq.replaceChildren(
          ...m.frequenze.map((f) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.dataset.frequenzaScelta = f;
            b.textContent = f;
            b.setAttribute('aria-pressed', String(f === k.frequenza));
            return b;
          }),
        );
      } else freq.textContent = m.frequenze.join(' ⇄ ');
      const input = $<HTMLInputElement>('[data-intensita]', col);
      if (Number(input.value) !== k.intensita) input.value = String(k.intensita);
      input.setAttribute('aria-valuetext', `${k.intensita}%`);
      $('[data-valore]', col).textContent = `${k.intensita}%`;
      $('[data-durata]', col).textContent = tempo(inCorso ? rimasto[id] : k.durata);
    }

    function aggiornaTotale() {
      const restante = inCorso ? Math.max(0, ...CORRENTI.map((c) => (canali[c.id].attivo ? rimasto[c.id] : 0))) : durataSeduta(canali);
      $('[data-totale]').textContent = restante >= 60 || restante === 0 ? `${Math.ceil(restante / 60)}'` : `${restante}"`;
      const frazione = inCorso && totaleIniziale ? restante / totaleIniziale : 1;
      $('[data-anello]').style.setProperty('--avanzamento', String(frazione));
      radice.classList.toggle('sim--in-corso', inCorso && !inPausa);
    }

    function aggiornaTutto() {
      for (const c of CORRENTI) aggiornaCanale(c.id);
      $('[data-swap]').setAttribute('aria-pressed', String(swap));
      aggiornaTotale();
      aggiornaAccessori();
      aggiornaProfondita();
    }

    function attiva(id: IdCorrente, valore = !canali[id].attivo) {
      const k = canali[id];
      k.attivo = valore;
      if (valore && k.durata === 0) k.durata = 180;
      if (valore && k.intensita === 0) k.intensita = 20;
      if (inCorso) rimasto[id] = valore ? k.durata : 0;
      if (!valore && (id === 'ret' || id === 'tens')) swap = false;
      aggiornaTutto();
    }

    function impostaIntensita(id: IdCorrente, valore: number) {
      const k = canali[id];
      k.intensita = limita(valore, 0, 100);
      if (k.intensita > 0 && !k.attivo) {
        k.attivo = true;
        if (k.durata === 0) k.durata = 180;
        if (inCorso) rimasto[id] = k.durata;
      }
      aggiornaCanale(id);
      aggiornaAccessori();
      aggiornaProfondita();
      aggiornaTotale();
    }

    function cambiaDurata(id: IdCorrente, verso: number) {
      const k = canali[id];
      k.durata = limita(k.durata + verso * PASSO_DURATA, 0, DURATA_MAX);
      if (inCorso) rimasto[id] = limita(rimasto[id] + verso * PASSO_DURATA, 0, DURATA_MAX);
      if (k.durata > 0 && !k.attivo) attiva(id, true);
      else aggiornaCanale(id);
      aggiornaTotale();
    }

    // ——— seduta ———
    function avviaSeduta() {
      if (!CORRENTI.some((c) => canali[c.id].attivo && canali[c.id].durata > 0)) {
        // nessuna corrente: ne attivo una per mostrare il funzionamento
        attiva('cet', true);
      }
      if (!inCorso) {
        for (const c of CORRENTI) rimasto[c.id] = canali[c.id].attivo ? canali[c.id].durata : 0;
        totaleIniziale = durataSeduta(canali);
        inCorso = true;
      }
      inPausa = false;
      ultimoTick = performance.now();
      aggiornaTutto();
    }

    function pausa() {
      if (inCorso) inPausa = !inPausa;
      ultimoTick = performance.now();
      aggiornaTotale();
    }

    function ferma() {
      inCorso = false;
      inPausa = false;
      aggiornaTutto();
    }

    // il tempo scorre 10 volte più veloce: una seduta di 4 minuti si vede in 24 secondi
    const ACCELERAZIONE = 10;
    let accumulato = 0;
    function ciclo(adesso: number) {
      if (inCorso && !inPausa) {
        accumulato += ((adesso - ultimoTick) / 1000) * ACCELERAZIONE;
        const secondi = Math.floor(accumulato);
        if (secondi > 0) {
          accumulato -= secondi;
          for (const c of CORRENTI) if (canali[c.id].attivo) rimasto[c.id] = Math.max(0, rimasto[c.id] - secondi);
          if (swap) faseSwap = Math.floor(adesso / 2500) % 2;
          if (CORRENTI.every((c) => !canali[c.id].attivo || rimasto[c.id] === 0)) ferma();
          else {
            for (const c of CORRENTI) $(`[data-canale="${c.id}"] [data-durata]`).textContent = tempo(rimasto[c.id]);
            aggiornaTotale();
            aggiornaAccessori();
          }
        }
      }
      ultimoTick = adesso;
      requestAnimationFrame(ciclo);
    }
    requestAnimationFrame(ciclo);

    // ——— accessori e corpo ———
    const correntiErogate = () =>
      CORRENTI.filter((c) => {
        const k = canali[c.id];
        if (!k.attivo || k.intensita === 0 || (inCorso && rimasto[c.id] === 0)) return false;
        // SWAP: RET e Hi-TENS si alternano
        if (swap && inCorso && c.id === 'ret') return faseSwap === 0;
        if (swap && inCorso && c.id === 'tens') return faseSwap === 1;
        return true;
      });

    function punto(x: number, y: number, classe: string, etichetta: string, colore?: string) {
      const g = document.createElementNS(SVG, 'g');
      g.setAttribute('class', `elettrodo ${classe}`);
      const forma = document.createElementNS(SVG, classe.includes('piastra') ? 'rect' : 'circle');
      if (forma.tagName === 'rect') {
        forma.setAttribute('x', String(x - 6));
        forma.setAttribute('y', String(y - 3.5));
        forma.setAttribute('width', '12');
        forma.setAttribute('height', '7');
        forma.setAttribute('rx', '1.5');
      } else {
        forma.setAttribute('cx', String(x));
        forma.setAttribute('cy', String(y));
        forma.setAttribute('r', classe.includes('mano') ? '3.4' : '2.6');
      }
      if (colore) forma.setAttribute('fill', colore);
      const testo = document.createElementNS(SVG, 'text');
      testo.setAttribute('x', String(x));
      testo.setAttribute('y', String(y - 4.5));
      testo.textContent = etichetta;
      g.append(forma, testo);
      return g;
    }

    function linea(a: [number, number], b: [number, number], colore: string, intensita: number, scarto = 0) {
      const l = document.createElementNS(SVG, 'line');
      l.setAttribute('x1', String(a[0] + scarto));
      l.setAttribute('y1', String(a[1] + scarto));
      l.setAttribute('x2', String(b[0] + scarto));
      l.setAttribute('y2', String(b[1] + scarto));
      l.setAttribute('stroke', colore);
      l.setAttribute('class', 'flusso');
      l.style.setProperty('--forza', String(0.35 + intensita * 0.65));
      return l;
    }

    function aggiornaAccessori() {
      const z = ZONE.find((x) => x.id === zona)!;
      for (const c of $$<SVGElement>('[data-zona-corpo]')) c.classList.toggle('corpo__zona--scelta', c.dataset.zonaCorpo === zona);
      for (const b of $$('[data-configurazione]')) b.setAttribute('aria-checked', String(b.dataset.configurazione === configurazione));
      $('[data-spiega-configurazione]').textContent = CONFIGURAZIONI.find((c) => c.id === configurazione)!.descrizione;

      const erogate = correntiErogate();
      const tecar = erogate.filter((c) => c.tipo === 'tecar');
      const colorePrincipale = (tecar[0] ?? erogate[0])?.colore ?? '#94a3b8';
      const lato = z.x < 50 ? 1 : -1;
      const elettrodi = $('[data-elettrodi]');
      const collegamenti = $('[data-collegamenti]');
      const punti: [number, number][] = [];
      const fig: SVGElement[] = [];

      switch (configurazione) {
        case 'piastra': {
          punti.push([z.x, z.y], [50, z.y > 50 ? 44 : 50]);
          fig.push(punto(...punti[0], '', 'TX', colorePrincipale), punto(...punti[1], 'elettrodo--piastra', 'Piastra'));
          break;
        }
        case 'due-tx':
          punti.push([z.x - 6, z.y], [z.x + 6, z.y + 4]);
          fig.push(punto(...punti[0], '', 'TX 1', colorePrincipale), punto(...punti[1], '', 'TX 2', (tecar[1] ?? tecar[0])?.colore ?? colorePrincipale));
          break;
        case 'tx-ritorno':
          punti.push([z.x, z.y], [z.x + lato * 9, z.y + 6]);
          fig.push(punto(...punti[0], '', 'TX eroga', colorePrincipale), punto(...punti[1], 'elettrodo--ritorno', 'TX ritorno'));
          break;
        case 'bracciali':
          punti.push([z.x - 4.5, z.y - 1], [z.x + 4.5, z.y + 1]);
          fig.push(punto(...punti[0], 'elettrodo--mano', 'mano', corrente('ret').colore), punto(...punti[1], 'elettrodo--mano', 'mano', corrente('ret').colore));
          break;
        case 'delta':
        case 'catena':
          punti.push([z.x, z.y - 7], [z.x - 8, z.y + 5], [z.x + 8, z.y + 5]);
          fig.push(...punti.map((p, i) => punto(...p, '', ['A', 'B', 'C'][i], colorePrincipale)));
          break;
      }

      const coppie: [number, number][] =
        configurazione === 'delta' ? [[0, 1], [1, 2], [2, 0]] : configurazione === 'catena' ? [[0, 1], [1, 2]] : [[0, 1]];
      const linee: SVGElement[] = [];
      // configurazione con i bracciali: solo RET (le mani diventano l'elettrodo)
      const scorrono = configurazione === 'bracciali' ? erogate.filter((c) => c.id === 'ret') : erogate;
      scorrono.forEach((c, i) => {
        for (const [a, b] of coppie) linee.push(linea(punti[a], punti[b], c.colore, canali[c.id].intensita / 100, (i - (scorrono.length - 1) / 2) * 1.2));
      });
      collegamenti.replaceChildren(...linee);
      elettrodi.replaceChildren(...fig);
      radice.classList.toggle('sim--flusso', inCorso && !inPausa && linee.length > 0);

      const nota = $('[data-nota-corpo]');
      if (configurazione === 'bracciali' && !canali.ret.attivo) nota.textContent = 'Con i bracciali lavora la corrente RET: attivala dallo schermo.';
      else if (canali.cet.attivo && canali.ret.attivo) nota.textContent = 'CET e RET insieme: BACK4 le eroga in simultanea sulle sue due vie indipendenti.';
      else if (!erogate.length) nota.textContent = 'Attiva una corrente e premi ▶ per vedere il passaggio di corrente. Tocca una zona per spostare i manipoli.';
      else nota.textContent = `${ZONE.find((x) => x.id === zona)!.nome}: ${erogate.map((c) => c.nome).join(' + ')}`;
    }

    function aggiornaProfondita() {
      const p = profondita(canali);
      for (const s of STRATI) {
        const barra = $(`[data-strato="${s.id}"] [data-strato-livello]`);
        barra.style.setProperty('--livello', String(p[s.id].livello));
        const colori = p[s.id].colori;
        barra.style.setProperty(
          '--sfumatura',
          colori.length ? `linear-gradient(90deg, ${colori.length > 1 ? colori.join(', ') : `${colori[0]}, ${colori[0]}`})` : 'none',
        );
      }
      const legenda = $('[data-legenda]');
      legenda.replaceChildren(
        ...CORRENTI.filter((c) => canali[c.id].attivo).map((c) => {
          const li = document.createElement('li');
          li.style.setProperty('--colore', c.colore);
          const m = modalita(c.id, canali[c.id].modalita);
          li.innerHTML = '<strong></strong> <span></span>';
          li.querySelector('strong')!.textContent = `${c.nome} ${m.nome}`;
          li.querySelector('span')!.textContent = `${canali[c.id].frequenza && c.id === 'tens' && m.id === 'manual' ? canali[c.id].frequenza : m.frequenze.join(' / ')} — ${m.descrizione}`;
          return li;
        }),
      );
    }

    // ——— eventi ———
    radice.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const vai = t.closest<HTMLElement>('[data-vai]');
      if (vai) return mostra(vai.dataset.vai as 'home' | 'academy' | 'expert');
      const z = t.closest<HTMLElement>('[data-zona]');
      if (z) {
        zona = z.dataset.zona as IdZona;
        aggiornaAccessori();
        return passoAcademy(2);
      }
      const f = t.closest<HTMLElement>('[data-fase]');
      if (f) {
        fase = f.dataset.fase as IdFase;
        return passoAcademy(3);
      }
      if (t.closest('[data-academy-indietro]')) return passoAcademy(1);
      if (t.closest('[data-academy-avvia]')) return caricaProgramma();

      const scheda = t.closest<HTMLElement>('[data-attiva]');
      if (scheda) return attiva(scheda.dataset.attiva as IdCorrente);
      if (t.closest('[data-swap]')) {
        swap = !swap;
        if (swap) {
          if (!canali.ret.attivo) attiva('ret', true);
          if (!canali.tens.attivo) attiva('tens', true);
        }
        return aggiornaTutto();
      }
      const colonna = t.closest<HTMLElement>('[data-canale]');
      const id = colonna?.dataset.canale as IdCorrente | undefined;
      const modo = t.closest<HTMLElement>('[data-modo]');
      if (modo && id) {
        canali[id].modalita = modo.dataset.modo!;
        if (!canali[id].attivo) return attiva(id, true);
        aggiornaCanale(id);
        return aggiornaProfondita();
      }
      const freq = t.closest<HTMLElement>('[data-frequenza-scelta]');
      if (freq && id) {
        canali[id].frequenza = freq.dataset.frequenzaScelta;
        aggiornaCanale(id);
        return aggiornaProfondita();
      }
      const tempoBtn = t.closest<HTMLElement>('[data-tempo]');
      if (tempoBtn && id) return cambiaDurata(id, Number(tempoBtn.dataset.tempo));
      if (t.closest('[data-avvia]')) return avviaSeduta();
      if (t.closest('[data-pausa]')) return pausa();
      if (t.closest('[data-ferma]')) return ferma();

      const conf = t.closest<HTMLElement>('[data-configurazione]');
      if (conf) {
        configurazione = conf.dataset.configurazione as IdConfigurazione;
        if (configurazione === 'bracciali' && !canali.ret.attivo) attiva('ret', true);
        return aggiornaAccessori();
      }
      if (t.closest('[data-urto]')) {
        // choc dei due TX: si passa da muscolo (CET) ad articolazione (RET) e viceversa
        const daCet = canali.cet.attivo || !canali.ret.attivo;
        const [da, a]: IdCorrente[] = daCet ? ['cet', 'ret'] : ['ret', 'cet'];
        canali[a].intensita = canali[da].intensita || 30;
        canali[a].durata = canali[da].durata || 180;
        if (inCorso) rimasto[a] = rimasto[da] || canali[a].durata;
        canali[da].attivo = false;
        canali[a].attivo = true;
        const bottone = $('[data-urto]');
        bottone.classList.remove('urto--scossa');
        void bottone.offsetWidth;
        bottone.classList.add('urto--scossa');
        mostra('expert');
        return aggiornaTutto();
      }
      const zonaCorpo = t.closest<SVGElement>('[data-zona-corpo]');
      if (zonaCorpo) {
        zona = zonaCorpo.dataset.zonaCorpo as IdZona;
        return aggiornaAccessori();
      }
    });

    // cursore della potenza: segue il dito in modo continuo
    radice.addEventListener('input', (e) => {
      const input = (e.target as HTMLElement).closest<HTMLInputElement>('[data-intensita]');
      const id = input?.closest<HTMLElement>('[data-canale]')?.dataset.canale as IdCorrente | undefined;
      if (input && id) impostaIntensita(id, Number(input.value));
    });

    // + e −: un tocco = 1%, tenendo premuto la potenza sale o scende in modo fluido
    let ripeti: number | undefined;
    const smetti = () => {
      clearInterval(ripeti);
      ripeti = undefined;
    };
    radice.addEventListener('pointerdown', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-passo]');
      const id = b?.closest<HTMLElement>('[data-canale]')?.dataset.canale as IdCorrente | undefined;
      if (!b || !id) return;
      e.preventDefault();
      const verso = Number(b.dataset.passo);
      impostaIntensita(id, canali[id].intensita + verso);
      let velocita = 0;
      smetti();
      ripeti = window.setInterval(() => {
        velocita = Math.min(velocita + 0.25, 3);
        impostaIntensita(id, canali[id].intensita + verso * Math.max(1, Math.floor(velocita)));
      }, 60);
    });
    for (const evento of ['pointerup', 'pointercancel', 'pointerleave', 'blur'] as const) radice.addEventListener(evento, smetti, true);
    // da tastiera i + e − funzionano con Invio/Spazio come tasti normali
    radice.addEventListener('keydown', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-passo]');
      const id = b?.closest<HTMLElement>('[data-canale]')?.dataset.canale as IdCorrente | undefined;
      if (b && id && (e.key === 'Enter' || e.key === ' ')) {
        e.preventDefault();
        impostaIntensita(id, canali[id].intensita + Number(b.dataset.passo));
      }
    });

    mostra('home');
    aggiornaTutto();
  }
</script>

