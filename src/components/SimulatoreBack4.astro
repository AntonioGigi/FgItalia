---
/**
 * Simulatore interattivo dello schermo Winback BACK4 (interfaccia 2.0), dentro la foto vera
 * del dispositivo. Solo dimostrazione: dati in src/lib/back4.ts.
 * Niente attributi style inline (li bloccherebbe la Content Security Policy): i valori dinamici
 * si impostano da script con le variabili CSS.
 */
import { CORRENTI, CONFIGURAZIONI, FASI, LIVELLI, STRATI, ZONE } from '../lib/back4';

const sagoma = [
  'M50 2.5a6.5 6.5 0 1 1 0 13a6.5 6.5 0 1 1 0-13z',
  'M46.5 14.5h7v5h-7z',
  'M36 20h28c3 0 5 2 5 5l-2 26c0 2-1.5 3.5-3.5 3.5h-27C34.5 54.5 33 53 33 51l-2-26c0-3 2-5 5-5z',
  'M31 22c-3 1-4.5 3-5.2 6L21 50c-.4 2 .8 3.5 2.6 3.6 1.4.1 2.5-.8 2.9-2.1l6.2-22z',
  'M69 22c3 1 4.5 3 5.2 6L79 50c.4 2-.8 3.5-2.6 3.6-1.4.1-2.5-.8-2.9-2.1l-6.2-22z',
  'M36.5 54h12l-1 48c0 2-1.5 3-3.2 3h-2.6c-1.7 0-3-1.2-3.1-2.9z',
  'M51.5 54h12l-2.1 48.1c-.1 1.7-1.4 2.9-3.1 2.9h-2.6c-1.7 0-3.2-1-3.2-3z',
];
---

<section class="sim" id="simulatore" aria-labelledby="sim-titolo" data-sim>
  <div class="contenitore">
    <div class="sim__testa">
      <span class="sopratitolo">Prova lo schermo</span>
      <h2 id="sim-titolo">Simulatore BACK4</h2>
      <p class="testo-intro">
        Lo schermo della BACK4, da toccare come quello vero: scegli <strong>Academy</strong> o <strong>Expert</strong>, trascina la potenza su
        e giù, cambia modalità e frequenze, avvia la seduta e guarda cosa succede nei tessuti.
      </p>
    </div>

    <div class="dispositivo" data-dispositivo>
      <img class="dispositivo__foto" src="/uploads/prodotti/back4-schermo.webp" alt="" width="750" height="540" loading="lazy" />

      <div class="schermo" data-schermo>
        <!-- ——— schermata iniziale ——— -->
        <div class="vista home" data-vista="home">
          <svg class="home__onde" viewBox="0 0 300 200" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="onda-arancio" x1="0" x2="1">
                <stop offset="0" stop-color="#ff7a3d" />
                <stop offset="1" stop-color="#b42318" stop-opacity="0" />
              </linearGradient>
              <linearGradient id="onda-viola" x1="0" x2="1">
                <stop offset="0" stop-color="#5b5bd6" stop-opacity="0" />
                <stop offset=".5" stop-color="#6d5bd6" />
                <stop offset="1" stop-color="#3b82f6" stop-opacity="0" />
              </linearGradient>
              <linearGradient id="onda-verde" x1="1" x2="0">
                <stop offset="0" stop-color="#4fb8a0" />
                <stop offset="1" stop-color="#0f766e" stop-opacity="0" />
              </linearGradient>
            </defs>
            <g class="home__banda home__banda--a">
              <path d="M0 78C40 60 70 100 110 92S170 70 190 80V112C160 104 130 128 100 122S40 96 0 112z" fill="url(#onda-arancio)" />
              <path d="M0 96C35 84 70 118 105 110S160 92 185 100V118C150 112 120 134 90 130S35 108 0 122z" fill="url(#onda-arancio)" opacity=".7" />
            </g>
            <g class="home__banda home__banda--b">
              <path d="M90 74C130 64 160 90 200 82S250 66 280 74V92C250 86 220 104 190 98S130 82 90 92z" fill="url(#onda-viola)" opacity=".8" />
            </g>
            <g class="home__banda home__banda--c">
              <path d="M140 92C180 80 210 110 250 100S290 86 300 90V124C270 116 240 132 210 126S170 108 140 116z" fill="url(#onda-verde)" />
              <path d="M160 110C190 102 220 124 255 118S290 106 300 108V128C275 124 250 138 220 134S185 122 160 128z" fill="url(#onda-verde)" opacity=".6" />
            </g>
          </svg>
          <div class="home__scelte">
            <button type="button" class="home__scelta" data-vai="academy">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="pieno"><path d="M12 3 1 8.5 12 14l9-4.5V16h2V8.5z" /><path d="M5 12.2V16c0 1.9 3.1 3.5 7 3.5s7-1.6 7-3.5v-3.8l-7 3.5z" /></svg>
              <strong>ACADEMY</strong><small>MODE</small>
            </button>
            <button type="button" class="home__scelta" data-vai="expert">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 2v20M12 2v20M18 2v20" /><circle cx="6" cy="15" r="2.4" /><circle cx="12" cy="8" r="2.4" /><circle cx="18" cy="13" r="2.4" />
              </svg>
              <strong>EXPERT</strong><small>MODE</small>
            </button>
          </div>
        </div>

        <!-- ——— Academy ——— -->
        <div class="vista academy" data-vista="academy" hidden>
          <div class="testata">
            <button type="button" class="testata__icona" data-academy-indietro aria-label="Indietro">‹</button>
            <span class="testata__titolo" data-titolo-academy>Seleziona la zona da trattare</span>
            <button type="button" class="testata__icona" data-vai="expert" aria-label="Passa a Expert mode">⚙︎</button>
          </div>
          <div class="academy__corpo">
            <svg class="academy__sagoma" viewBox="12 0 76 108" aria-label="Zone del corpo">
              <g class="academy__figura">{sagoma.map((d) => <path d={d} />)}</g>
              {
                ZONE.map((z) => (
                  <g class="academy__punto" data-zona={z.id} role="button" tabindex="0" aria-label={z.nome}>
                    <circle cx={z.x} cy={z.y} r="5" class="academy__alone" />
                    <circle cx={z.x} cy={z.y} r="2" />
                  </g>
                ))
              }
            </svg>
            <div class="academy__lato">
              <div data-academy-passo="1">
                <div class="academy__lista">
                  {ZONE.map((z) => (
                    <button type="button" data-zona={z.id}>
                      {z.nome}
                    </button>
                  ))}
                </div>
              </div>
              <div data-academy-passo="2" hidden>
                <div class="academy__lista academy__lista--fasi">
                  {FASI.map((f) => (
                    <button type="button" data-fase={f.id}>
                      <strong>{f.nome}</strong>
                      <small>{f.descrizione}</small>
                    </button>
                  ))}
                </div>
              </div>
              <div data-academy-passo="3" hidden>
                <ol class="academy__programma" data-academy-programma></ol>
                <button type="button" class="academy__avvia" data-academy-avvia>Avvia il protocollo ▶</button>
                <p class="academy__nota">Protocollo di esempio per la demo</p>
              </div>
            </div>
          </div>
        </div>

        <!-- ——— Expert ——— -->
        <div class="vista expert" data-vista="expert" hidden>
          <div class="testata testata--expert">
            <button type="button" class="testata__icona" data-vai="home" aria-label="Schermata iniziale">‹</button>
            <span></span>
            <button type="button" class="testata__icona testata__icona--tenue" data-azzera aria-label="Nuova seduta">+</button>
          </div>

          <div class="colonne">
            {
              CORRENTI.map((c) => (
                <div class={`col col--${c.id}`} data-canale={c.id}>
                  <button type="button" class="col__testa" data-attiva aria-pressed="false" aria-label={`${c.nome}: attiva o disattiva`}>
                    <i class="angolo angolo--a" />
                    <i class="angolo angolo--b" />
                    <i class="angolo angolo--c" />
                    <i class="angolo angolo--d" />
                    <strong>{c.nome}</strong>
                  </button>
                  <button type="button" class="col__tempo" data-apri-tempo aria-label={`Durata ${c.nome}`}>
                    <span data-durata>02:30</span>
                  </button>
                  <div class="col__regola-tempo" data-regola-tempo hidden>
                    <button type="button" data-tempo="-1" aria-label="Meno tempo">−</button>
                    <button type="button" data-tempo="1" aria-label="Più tempo">+</button>
                  </div>
                  <div class="col__opzioni">
                    {c.id === 'mix' ? (
                      <button type="button" data-cicla="frequenza" />
                    ) : (
                      <button type="button" data-cicla="modo" />
                    )}
                    {c.livelli && <button type="button" data-cicla="livello" />}
                  </div>
                  <div
                    class="col__potenza"
                    data-potenza
                    role="slider"
                    tabindex="0"
                    aria-label={`Potenza ${c.nome}`}
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-valuenow="0"
                  >
                    <div class="col__liquido" aria-hidden="true">
                      <i class="col__onda" />
                    </div>
                    <div class="col__tacche" aria-hidden="true" />
                    {c.frequenzeScelta && c.id === 'tens' ? (
                      <div class="col__frequenze">
                        <span class="col__percento" data-pillola>
                          0%
                        </span>
                        {c.frequenzeScelta.map((f) => (
                          <button type="button" data-frequenza={f} aria-label={f}>
                            {f.split(' ')[0]}
                            <small>Hz</small>
                          </button>
                        ))}
                      </div>
                    ) : (
                      <span class="col__pillola" data-pillola>
                        0<small>%</small>
                      </span>
                    )}
                  </div>
                  {c.id === 'ret' && (
                    <button type="button" class="swap" data-swap aria-pressed="false" aria-label="SWAP: alterna RET e Hi-TENS">
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M19 8a7 7 0 0 0-12.6-2.2L5 7.5" />
                        <path d="M5 3.5v4h4" />
                        <path d="M5 16a7 7 0 0 0 12.6 2.2l1.4-1.7" />
                        <path d="M19 20.5v-4h-4" />
                      </svg>
                    </button>
                  )}
                </div>
              ))
            }
          </div>

          <div class="fondo">
            <div class="fondo__accessori">
              <button type="button" class="accessorio accessorio--piastra" data-accessorio="piastra" aria-label="Piastra di ritorno">
                <svg viewBox="0 0 30 40" aria-hidden="true">
                  <rect x="4" y="2" width="22" height="30" rx="4" class="metallo" />
                  <path d="M15 32v6" class="cavo" />
                  <circle cx="15" cy="17" r="5" class="spunta-cerchio" />
                  <path d="m12.6 17 1.7 1.7 3.2-3.4" class="spunta" />
                </svg>
              </button>
              <button type="button" class="accessorio" data-accessorio="tx1" aria-label="Manipolo TX 1">
                <svg viewBox="0 0 34 40" aria-hidden="true">
                  <path d="M5 6c0-2 1.5-3.5 3.5-3.5h17C27.5 2.5 29 4 29 6v9c0 3-2.5 5.5-5.5 5.5h-13C7.5 20.5 5 18 5 15z" class="corpo-tx" />
                  <path d="M10 6h14" class="riflesso" /><path d="M17 20.5v9" class="stelo" /><ellipse cx="17" cy="32" rx="9" ry="3.2" class="base" />
                </svg>
              </button>
              <button type="button" class="accessorio" data-accessorio="tx2" aria-label="Manipolo TX 2">
                <svg viewBox="0 0 34 40" aria-hidden="true">
                  <path d="M5 6c0-2 1.5-3.5 3.5-3.5h17C27.5 2.5 29 4 29 6v9c0 3-2.5 5.5-5.5 5.5h-13C7.5 20.5 5 18 5 15z" class="corpo-tx" />
                  <path d="M10 6h14" class="riflesso" /><path d="M17 20.5v9" class="stelo" /><ellipse cx="17" cy="32" rx="9" ry="3.2" class="base" />
                </svg>
              </button>
            </div>

            <div class="timer">
              <svg viewBox="0 0 100 100" aria-hidden="true">
                <circle cx="50" cy="50" r="44" class="timer__tacche" />
                <circle cx="50" cy="50" r="44" class="timer__fatto" data-anello />
              </svg>
              <span class="timer__tempo" data-totale>00:00</span>
              <div class="timer__tasti">
                <button type="button" data-avvia aria-label="Avvia o metti in pausa">
                  <svg viewBox="0 0 24 24" aria-hidden="true" class="icona-avvia"><path d="M8 5v14l11-7z" /></svg>
                  <svg viewBox="0 0 24 24" aria-hidden="true" class="icona-pausa"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
                </button>
                <button type="button" data-ferma aria-label="Ferma">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="1.5" /></svg>
                </button>
              </div>
            </div>

            <div class="fondo__destra">
              <span class="fondo__wifi" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M2 9a15 15 0 0 1 20 0M5 12.5a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0" /><circle cx="12" cy="19.5" r="1.3" /></svg>
              </span>
              <button type="button" class="fondo__icona" data-impostazioni aria-label="Impostazioni">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M10.3 2h3.4l.5 2.6 1.9.8 2.2-1.5 2.4 2.4-1.5 2.2.8 1.9 2.6.5v3.4l-2.6.5-.8 1.9 1.5 2.2-2.4 2.4-2.2-1.5-1.9.8-.5 2.6h-3.4l-.5-2.6-1.9-.8-2.2 1.5-2.4-2.4 1.5-2.2-.8-1.9L2 13.7v-3.4l2.6-.5.8-1.9-1.5-2.2 2.4-2.4 2.2 1.5 1.9-.8z"
                  />
                  <circle cx="12" cy="12" r="3.2" class="foro" />
                </svg>
              </button>
              <button type="button" class="fondo__academy" data-vai="academy">
                <svg viewBox="0 0 24 24" aria-hidden="true" class="pieno"><path d="M12 3 1 8.5 12 14l9-4.5V16h2V8.5z" /><path d="M5 12.2V16c0 1.9 3.1 3.5 7 3.5s7-1.6 7-3.5v-3.8l-7 3.5z" /></svg>
                <strong>ACADEMY</strong><small>MODE</small>
              </button>
            </div>
          </div>

          <div class="foglio" data-foglio hidden>
            <p class="foglio__titolo">Impostazioni</p>
            <label><input type="checkbox" data-opzione="suoni" /> Suoni dei tasti</label>
            <label><input type="checkbox" data-opzione="vibrazione" checked /> Vibrazione (telefono)</label>
            <button type="button" data-chiudi-foglio>Chiudi</button>
          </div>
        </div>
      </div>

      <button type="button" class="dispositivo__intero" data-schermo-intero>⤢ Schermo intero</button>
    </div>

    <!-- ——— cosa succede sul paziente ——— -->
    <div class="pannelli">
      <div class="pannello-sim">
        <h3>Manipoli e accessori</h3>
        <div class="configurazioni" role="radiogroup" aria-label="Configurazione degli accessori">
          {CONFIGURAZIONI.map((c, i) => (
            <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-configurazione={c.id}>
              {c.nome}
            </button>
          ))}
        </div>
        <p class="pannello-sim__spiega" data-spiega-configurazione></p>
        <p class="pannello-sim__nota">
          Trascina un manipolo sull’altro per “urtarli”: come sul dispositivo vero, si passa dall’azione muscolare (CET) a quella articolare (RET).
        </p>
      </div>

      <div class="pannello-sim pannello-sim--corpo">
        <h3>Sul paziente</h3>
        <svg class="corpo" viewBox="12 0 76 110" role="img" aria-label="Manipoli sul corpo del paziente" data-corpo>
          <defs>
            <radialGradient id="calore-grad">
              <stop offset="0" stop-color="#ff5a1f" stop-opacity=".85" />
              <stop offset=".55" stop-color="#ffb020" stop-opacity=".35" />
              <stop offset="1" stop-color="#ffb020" stop-opacity="0" />
            </radialGradient>
          </defs>
          <g class="corpo__sagoma" aria-hidden="true">{sagoma.map((d) => <path d={d} />)}</g>
          <circle r="9" fill="url(#calore-grad)" class="corpo__calore" data-calore />
          <g data-collegamenti></g>
          <g data-elettrodi></g>
        </svg>
        <p class="pannello-sim__stato" data-nota-corpo aria-live="polite"></p>
        <div class="calore">
          <span>Riscaldamento dei tessuti</span>
          <span class="calore__barra"><span data-calore-barra></span></span>
        </div>
      </div>

      <div class="pannello-sim">
        <h3>Profondità d’azione</h3>
        <ul class="strati">
          {STRATI.map((s) => (
            <li data-strato={s.id}>
              <span class="strati__nome">
                {s.nome}
                <small>{s.dettaglio}</small>
              </span>
              <span class="strati__barra">
                <span data-strato-livello />
              </span>
            </li>
          ))}
        </ul>
        <ul class="legenda" data-legenda></ul>
      </div>
    </div>

    <p class="sim__avviso">
      Simulazione a scopo illustrativo, non è il software ufficiale Winback. Correnti, frequenze e accessori dalla scheda tecnica del dispositivo;
      i protocolli Academy mostrati sono esempi. Il trattamento va sempre scelto da un professionista sanitario.
    </p>
  </div>
</section>

<script>
  import {
    CONFIGURAZIONI,
    CORRENTI,
    DURATA_MAX,
    FASI,
    LIVELLI,
    PASSO_DURATA,
    STRATI,
    ZONE,
    corrente,
    durataSeduta,
    frequenzeCanale,
    inErogazione,
    limita,
    modalita,
    profondita,
    programmaEsempio,
    tempo,
    type Canale,
    type IdConfigurazione,
    type IdCorrente,
    type IdFase,
    type IdZona,
  } from '../lib/back4';

  const radice = document.querySelector<HTMLElement>('[data-sim]');
  if (radice) avvia(radice);

  function avvia(radice: HTMLElement) {
    const $ = <T extends Element = HTMLElement>(s: string, base: ParentNode = radice) => base.querySelector<T>(s)!;
    const $$ = <T extends Element = HTMLElement>(s: string, base: ParentNode = radice) => [...base.querySelectorAll<T>(s)];
    const SVG = 'http://www.w3.org/2000/svg';
    const colonna = (id: IdCorrente) => $(`[data-canale="${id}"]`);

    // ——— stato ———
    // stato iniziale come sul dispositivo: CET Soft/Low, RET Deep/Medium, Hi-TENS Static 25 Hz, Hi-EMS Radial, MIX 5 Hz/Medium
    const canali: Record<IdCorrente, Canale> = {
      cet: { attivo: false, modalita: 'soft', livello: 'low', intensita: 0, durata: 150 },
      ret: { attivo: false, modalita: 'deep', livello: 'medium', intensita: 0, durata: 150 },
      tens: { attivo: false, modalita: 'static', frequenza: '25 Hz', intensita: 0, durata: 150 },
      ems: { attivo: false, modalita: 'radial', intensita: 0, durata: 150 },
      mix: { attivo: false, modalita: 'pulse', livello: 'medium', frequenza: '5 Hz', intensita: 0, durata: 150 },
    };
    const mostrato: Record<IdCorrente, number> = { cet: 0, ret: 0, tens: 0, ems: 0, mix: 0 };
    let scelto: IdCorrente = 'cet';
    let trascorsi = 0;
    let inCorso = false;
    let inPausa = false;
    let swap = false;
    let configurazione: IdConfigurazione = 'piastra';
    let zona: IdZona = 'spalla';
    let fase: IdFase | undefined;
    let calore = 0;
    let fermoDa = 0;
    const opzioni = { suoni: false, vibrazione: true };
    /** posizione dei manipoli sul corpo (coordinate del disegno) */
    let posizioni: [number, number][] = [];

    // ——— suoni e vibrazione ———
    let audio: AudioContext | undefined;
    function clic(frequenza = 1800, durata = 0.03) {
      if (!opzioni.suoni) return;
      try {
        audio ??= new AudioContext();
        const o = audio.createOscillator();
        const g = audio.createGain();
        o.frequency.value = frequenza;
        g.gain.setValueAtTime(0.05, audio.currentTime);
        g.gain.exponentialRampToValueAtTime(0.0001, audio.currentTime + durata);
        o.connect(g).connect(audio.destination);
        o.start();
        o.stop(audio.currentTime + durata);
      } catch {
        /* audio non disponibile */
      }
    }
    const vibra = (ms = 8) => opzioni.vibrazione && navigator.vibrate?.(ms);

    // ——— viste ———
    function mostra(vista: 'home' | 'academy' | 'expert') {
      for (const v of $$('[data-vista]')) v.hidden = v.dataset.vista !== vista;
      if (vista === 'academy') passoAcademy(1);
      clic(1200);
    }

    // ——— Academy ———
    function passoAcademy(n: 1 | 2 | 3) {
      for (const p of $$('[data-academy-passo]')) p.hidden = p.dataset.academyPasso !== String(n);
      for (const z of $$('[data-zona]')) z.classList.toggle('scelta', z.dataset.zona === zona);
      radice.classList.toggle('sim--scegli-zona', n === 1);
      const nomeZona = ZONE.find((z) => z.id === zona)!.nome;
      $('[data-titolo-academy]').textContent =
        n === 1 ? 'Seleziona la zona da trattare' : n === 2 ? `${nomeZona} · Seleziona la fase` : `${nomeZona} · ${FASI.find((f) => f.id === fase)!.nome}`;
      if (n === 3 && fase) {
        const prog = programmaEsempio(zona, fase);
        $('[data-academy-programma]').replaceChildren(
          ...CORRENTI.filter((c) => prog[c.id].attivo).map((c) => {
            const k = prog[c.id];
            const li = document.createElement('li');
            li.style.setProperty('--colore', c.colore);
            const nome = document.createElement('strong');
            nome.textContent = c.nome;
            const dett = document.createElement('span');
            dett.textContent = `${modalita(c.id, k.modalita).nome}${k.livello ? ` · ${LIVELLI.find((l) => l.id === k.livello)!.nome}` : ''} · ${frequenzeCanale(c.id, k).join(' / ')}`;
            const dati = document.createElement('em');
            dati.textContent = `${k.intensita}% · ${tempo(k.durata)}`;
            li.append(nome, dett, dati);
            return li;
          }),
        );
      }
    }

    function caricaProgramma() {
      if (!fase) return;
      ferma();
      Object.assign(canali, programmaEsempio(zona, fase));
      configurazione = zona === 'lombare' || zona === 'dorsale' ? 'due-tx' : 'piastra';
      posizioni = [];
      mostra('expert');
      aggiornaTutto();
      avviaSeduta();
    }

    // ——— colonne Expert ———
    function aggiornaColonna(id: IdCorrente, inErog?: ReturnType<typeof inErogazione>) {
      const c = corrente(id);
      const k = canali[id];
      const col = colonna(id);
      col.classList.toggle('col--attiva', k.attivo);
      col.classList.toggle('col--scelta', !inCorso && scelto === id && k.attivo);
      const eroga = !!inErog && inCorso && (inErog.via1 === id || inErog.via2 === id) && !(swap && id === 'tens' && faseSwap() === 0) && !(swap && id === 'ret' && faseSwap() === 1);
      col.classList.toggle('col--eroga', eroga);
      col.style.setProperty('--colore', c.colore);
      col.style.setProperty('--scuro', c.scuro);
      $('[data-attiva]', col).setAttribute('aria-pressed', String(k.attivo));
      $('[data-durata]', col).textContent = tempo(inCorso && inErog ? inErog.restanti[id] : k.durata);
      const modo = col.querySelector<HTMLElement>('[data-cicla="modo"]');
      if (modo) modo.textContent = modalita(id, k.modalita).nome;
      const liv = col.querySelector<HTMLElement>('[data-cicla="livello"]');
      if (liv) liv.textContent = LIVELLI.find((l) => l.id === k.livello)?.nome ?? 'Medium';
      const fr = col.querySelector<HTMLElement>('[data-cicla="frequenza"]');
      if (fr) fr.textContent = k.frequenza ?? '5 Hz';
      for (const b of $$('[data-frequenza]', col)) b.setAttribute('aria-pressed', String(k.modalita === 'static' ? b.dataset.frequenza === k.frequenza : true));
      const potenza = $('[data-potenza]', col);
      potenza.setAttribute('aria-valuenow', String(k.intensita));
      potenza.setAttribute('aria-valuetext', `${k.intensita}%`);
      const pillola = $('[data-pillola]', col);
      pillola.firstChild!.textContent = id === 'tens' ? `${k.intensita}%` : String(k.intensita);
    }

    const faseSwap = () => Math.floor(trascorsi / 15) % 2;

    function aggiornaTotale(inErog = inErogazione(canali, trascorsi)) {
      const totale = durataSeduta(canali);
      const restante = inCorso ? Math.max(0, totale - trascorsi) : totale;
      $('[data-totale]').textContent = tempo(restante);
      $('[data-anello]').style.setProperty('--fatto', String(inCorso && totale ? trascorsi / totale : 0));
      radice.classList.toggle('sim--in-corso', inCorso && !inPausa);
      for (const c of CORRENTI) aggiornaColonna(c.id, inErog);
    }

    function aggiornaTutto() {
      $('[data-swap]').setAttribute('aria-pressed', String(swap));
      aggiornaTotale();
      aggiornaAccessori();
      aggiornaProfondita();
    }

    function attiva(id: IdCorrente, valore = !canali[id].attivo) {
      const k = canali[id];
      k.attivo = valore;
      if (valore && k.intensita === 0) k.intensita = 30;
      if (valore && k.durata === 0) k.durata = 150;
      if (!valore && (id === 'ret' || id === 'tens')) swap = false;
      scelto = id;
      clic(valore ? 1500 : 900);
      vibra(12);
      aggiornaTutto();
    }

    let ultimoScatto: Partial<Record<IdCorrente, number>> = {};
    function impostaIntensita(id: IdCorrente, valore: number) {
      const k = canali[id];
      const nuovo = limita(valore, 0, 100);
      if (nuovo === k.intensita) return;
      k.intensita = nuovo;
      if (nuovo > 0 && !k.attivo) k.attivo = true;
      scelto = id;
      // uno scatto ogni 5%, come una manopola
      const scatto = Math.floor(nuovo / 5);
      if (scatto !== ultimoScatto[id]) {
        ultimoScatto[id] = scatto;
        clic(900 + nuovo * 12, 0.015);
        vibra(5);
      }
      aggiornaTotale();
      aggiornaAccessori();
      aggiornaProfondita();
    }

    function cicla(id: IdCorrente, cosa: string) {
      const c = corrente(id);
      const k = canali[id];
      const prossimo = <T,>(lista: T[], attuale: T) => lista[(lista.indexOf(attuale) + 1) % lista.length];
      if (cosa === 'modo') k.modalita = prossimo(c.modalita.map((m) => m.id), k.modalita);
      if (cosa === 'livello') k.livello = prossimo(LIVELLI.map((l) => l.id), k.livello ?? 'medium');
      if (cosa === 'frequenza' && c.frequenzeScelta) k.frequenza = prossimo(c.frequenzeScelta, k.frequenza ?? c.frequenzeScelta[0]);
      if (!k.attivo) k.attivo = true;
      scelto = id;
      clic(1600);
      aggiornaTotale();
      aggiornaProfondita();
    }

    // ——— seduta ———
    function avviaSeduta() {
      if (!CORRENTI.some((c) => canali[c.id].attivo)) attiva('cet', true);
      if (!inCorso) {
        trascorsi = 0;
        inCorso = true;
        inPausa = false;
      } else inPausa = !inPausa;
      clic(inPausa ? 700 : 2000, 0.06);
      vibra(20);
      aggiornaTutto();
    }

    function ferma() {
      inCorso = false;
      inPausa = false;
      trascorsi = 0;
      clic(500, 0.08);
      aggiornaTutto();
    }

    // il tempo scorre 10 volte più veloce: una seduta di 5 minuti si vede in 30 secondi
    const ACCELERAZIONE = 10;
    let ultimo = performance.now();
    let accumulato = 0;
    function ciclo(adesso: number) {
      const dt = Math.min(0.1, (adesso - ultimo) / 1000);
      ultimo = adesso;
      // la potenza mostrata insegue quella impostata: movimento morbido
      for (const c of CORRENTI) {
        const obiettivo = canali[c.id].attivo ? canali[c.id].intensita : 0;
        const prima = mostrato[c.id];
        mostrato[c.id] += (obiettivo - mostrato[c.id]) * Math.min(1, dt * 14);
        if (Math.abs(mostrato[c.id] - prima) > 0.01) colonna(c.id).style.setProperty('--livello', (mostrato[c.id] / 100).toFixed(4));
      }
      if (inCorso && !inPausa) {
        accumulato += dt * ACCELERAZIONE;
        const s = Math.floor(accumulato);
        if (s > 0) {
          accumulato -= s;
          trascorsi += s;
          if (trascorsi >= durataSeduta(canali)) {
            ferma();
            clic(2200, 0.25);
            vibra(120);
          } else {
            aggiornaTotale();
            aggiornaAccessori();
          }
        }
      }
      aggiornaCalore(dt);
      requestAnimationFrame(ciclo);
    }
    requestAnimationFrame(ciclo);

    // ——— corpo del paziente: manipoli trascinabili, calore ———
    const correntiErogate = () => {
      if (!inCorso || inPausa) return [];
      const e = inErogazione(canali, trascorsi);
      return CORRENTI.filter((c) => {
        if (canali[c.id].intensita === 0) return false;
        if (swap && c.id === 'tens') return faseSwap() === 1 && e.restanti.tens > 0;
        if (swap && c.id === 'ret') return faseSwap() === 0 && e.restanti.ret > 0;
        return e.via1 === c.id || e.via2 === c.id;
      });
    };

    function posizioniIniziali(): [number, number][] {
      const z = ZONE.find((x) => x.id === zona)!;
      switch (configurazione) {
        case 'piastra':
          return [[z.x, z.y], [50, z.y > 50 ? 44 : 50]];
        case 'due-tx':
          return [[z.x - 6, z.y], [z.x + 6, z.y + 4]];
        case 'tx-ritorno':
          return [[z.x, z.y], [z.x + (z.x < 50 ? 9 : -9), z.y + 6]];
        case 'bracciali':
          return [[z.x - 4.5, z.y - 1], [z.x + 4.5, z.y + 1], [50, z.y > 50 ? 44 : 50]];
        default:
          return [[z.x, z.y - 7], [z.x - 8, z.y + 5], [z.x + 8, z.y + 5]];
      }
    }

    const etichette = () =>
      ({
        piastra: ['TX', 'Piastra'],
        'due-tx': ['TX 1', 'TX 2'],
        'tx-ritorno': ['TX eroga', 'TX ritorno'],
        bracciali: ['mano', 'mano', 'Piastra'],
        delta: ['A', 'B', 'C'],
        catena: ['A', 'B', 'C'],
      })[configurazione];

    function aggiornaAccessori() {
      if (posizioni.length !== etichette().length) posizioni = posizioniIniziali();
      const conf = CONFIGURAZIONI.find((c) => c.id === configurazione)!;
      for (const b of $$('[data-configurazione]')) b.setAttribute('aria-checked', String(b.dataset.configurazione === configurazione));
      $('[data-spiega-configurazione]').textContent = conf.descrizione;
      $('[data-accessorio="piastra"]').classList.toggle('collegato', conf.piastra);
      $('[data-accessorio="tx1"]').classList.toggle('collegato', conf.tx >= 1 || configurazione === 'bracciali');
      $('[data-accessorio="tx2"]').classList.toggle('collegato', conf.tx >= 2);

      const erogate = correntiErogate();
      const tecar = erogate.filter((c) => c.tipo === 'tecar');
      const colore = (tecar[0] ?? erogate[0])?.colore ?? '#94a3b8';
      const nomi = etichette();
      $('[data-elettrodi]').replaceChildren(
        ...posizioni.map((p, i) => {
          const g = document.createElementNS(SVG, 'g');
          const tipo = nomi[i] === 'Piastra' ? 'piastra' : nomi[i] === 'TX ritorno' ? 'ritorno' : nomi[i] === 'mano' ? 'mano' : 'tx';
          g.setAttribute('class', `elettrodo elettrodo--${tipo}`);
          g.setAttribute('transform', `translate(${p[0]} ${p[1]})`);
          g.dataset.elettrodo = String(i);
          const forma = document.createElementNS(SVG, tipo === 'piastra' ? 'rect' : 'circle');
          if (tipo === 'piastra') {
            for (const [a, v] of Object.entries({ x: -6, y: -3.5, width: 12, height: 7, rx: 1.5 })) forma.setAttribute(a, String(v));
          } else {
            forma.setAttribute('r', tipo === 'mano' ? '3.4' : '3');
            if (tipo === 'tx') forma.setAttribute('fill', colore);
            if (tipo === 'mano') forma.setAttribute('fill', corrente('ret').colore);
          }
          const testo = document.createElementNS(SVG, 'text');
          testo.setAttribute('y', '-5');
          testo.textContent = nomi[i];
          g.append(forma, testo);
          return g;
        }),
      );

      const coppie: [number, number][] =
        configurazione === 'delta' ? [[0, 1], [1, 2], [2, 0]] : configurazione === 'catena' ? [[0, 1], [1, 2]] : configurazione === 'bracciali' ? [[0, 2], [1, 2]] : [[0, 1]];
      const scorrono = configurazione === 'bracciali' ? erogate.filter((c) => c.id === 'ret') : erogate;
      $('[data-collegamenti]').replaceChildren(
        ...scorrono.flatMap((c, i) =>
          coppie.map(([a, b]) => {
            const l = document.createElementNS(SVG, 'line');
            const scarto = (i - (scorrono.length - 1) / 2) * 1.3;
            l.setAttribute('x1', String(posizioni[a][0] + scarto));
            l.setAttribute('y1', String(posizioni[a][1] + scarto));
            l.setAttribute('x2', String(posizioni[b][0] + scarto));
            l.setAttribute('y2', String(posizioni[b][1] + scarto));
            l.setAttribute('stroke', c.colore);
            l.setAttribute('class', 'flusso');
            l.style.setProperty('--forza', String(0.3 + (canali[c.id].intensita / 100) * 0.7));
            return l;
          }),
        ),
      );
      scriviStato(erogate);
    }

    function scriviStato(erogate = correntiErogate()) {
      const nota = $('[data-nota-corpo]');
      if (configurazione === 'bracciali' && !canali.ret.attivo) nota.textContent = 'Con i bracciali lavora la corrente RET: attivala sullo schermo.';
      else if (!inCorso) nota.textContent = 'Trascina i manipoli sulla zona da trattare, poi premi ▶ sullo schermo.';
      else if (inPausa) nota.textContent = 'Seduta in pausa.';
      else if (fermoDa > 2.5 && calore > 0.55) nota.textContent = '⚠ Il manipolo è fermo da un po’: muovilo per distribuire il calore.';
      else nota.textContent = `In erogazione: ${erogate.map((c) => `${c.nome} ${canali[c.id].intensita}%`).join(' + ') || '—'}`;
    }

    // il calore cresce con la potenza TECAR e il tempo, cala a seduta ferma; il manipolo fermo lo concentra
    function aggiornaCalore(dt: number) {
      const tecar = correntiErogate().filter((c) => c.tipo === 'tecar');
      const potenza = tecar.reduce((s, c) => s + canali[c.id].intensita / 100, 0);
      const prima = calore;
      calore = Math.max(0, Math.min(1, calore + dt * (potenza * 0.09 * (fermoDa > 2 ? 1.6 : 1) - 0.035)));
      if (inCorso && !inPausa) fermoDa += dt;
      if (Math.abs(prima - calore) > 0.0005) {
        const c = $<SVGCircleElement>('[data-calore]');
        const p = posizioni[0] ?? [50, 50];
        c.setAttribute('cx', String(p[0]));
        c.setAttribute('cy', String(p[1]));
        c.style.setProperty('--calore', calore.toFixed(3));
        $('[data-calore-barra]').style.setProperty('--calore', calore.toFixed(3));
      }
      if (Math.floor(prima * 20) !== Math.floor(calore * 20) || (fermoDa > 2.5 && calore > 0.55)) scriviStato();
    }

    // trascinamento dei manipoli sul corpo
    const corpo = $<SVGSVGElement>('[data-corpo]');
    let trascinato: number | undefined;
    const puntoSvg = (e: PointerEvent): [number, number] => {
      const p = corpo.createSVGPoint();
      p.x = e.clientX;
      p.y = e.clientY;
      const r = p.matrixTransform(corpo.getScreenCTM()!.inverse());
      return [limita(r.x, 14, 86), limita(r.y, 2, 106)];
    };
    corpo.addEventListener('pointerdown', (e) => {
      const g = (e.target as Element).closest<SVGGElement>('[data-elettrodo]');
      if (!g) return;
      trascinato = Number(g.dataset.elettrodo);
      corpo.setPointerCapture(e.pointerId);
      e.preventDefault();
    });
    corpo.addEventListener('pointermove', (e) => {
      if (trascinato === undefined) return;
      posizioni[trascinato] = puntoSvg(e);
      fermoDa = 0;
      // urto: due manipoli TX che si toccano → si passa da CET a RET (e viceversa)
      const tx = posizioni.filter((_, i) => /^TX/.test(etichette()[i]));
      if (tx.length === 2 && Math.hypot(tx[0][0] - tx[1][0], tx[0][1] - tx[1][1]) < 4) urto();
      aggiornaAccessori();
    });
    const lascia = () => (trascinato = undefined);
    corpo.addEventListener('pointerup', lascia);
    corpo.addEventListener('pointercancel', lascia);

    let ultimoUrto = 0;
    function urto() {
      if (performance.now() - ultimoUrto < 1200) return;
      ultimoUrto = performance.now();
      const daCet = canali.cet.attivo || !canali.ret.attivo;
      const [da, a]: IdCorrente[] = daCet ? ['cet', 'ret'] : ['ret', 'cet'];
      canali[a].intensita = canali[da].intensita || 40;
      canali[a].durata = canali[da].durata || 150;
      canali[da].attivo = false;
      canali[a].attivo = true;
      // i manipoli si separano dopo l'urto
      posizioni = posizioniIniziali();
      clic(300, 0.12);
      vibra(60);
      radice.classList.remove('sim--urto');
      void radice.offsetWidth;
      radice.classList.add('sim--urto');
      if ($('[data-vista="expert"]').hidden) mostra('expert');
      aggiornaTutto();
    }

    function aggiornaProfondita() {
      const p = profondita(canali);
      for (const s of STRATI) {
        const barra = $(`[data-strato="${s.id}"] [data-strato-livello]`);
        barra.style.setProperty('--livello', String(p[s.id].livello));
        const colori = p[s.id].colori;
        barra.style.setProperty('--sfumatura', colori.length ? `linear-gradient(90deg, ${(colori.length > 1 ? colori : [colori[0], colori[0]]).join(', ')})` : 'none');
      }
      $('[data-legenda]').replaceChildren(
        ...CORRENTI.filter((c) => canali[c.id].attivo).map((c) => {
          const li = document.createElement('li');
          li.style.setProperty('--colore', c.colore);
          const m = modalita(c.id, canali[c.id].modalita);
          const nome = document.createElement('strong');
          nome.textContent = `${c.nome} ${m.nome}`;
          li.append(nome, ` ${frequenzeCanale(c.id, canali[c.id]).join(' / ')} — ${m.descrizione}`);
          return li;
        }),
      );
    }

    // ——— potenza: trascinamento morbido su tutta la colonna ———
    let trascinaPotenza: { id: IdCorrente; area: HTMLElement } | undefined;
    const valoreDaY = (area: HTMLElement, y: number) => {
      const r = area.getBoundingClientRect();
      return ((r.bottom - y) / r.height) * 100;
    };
    radice.addEventListener('pointerdown', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-frequenza]')) return;
      const area = t.closest<HTMLElement>('[data-potenza]');
      const id = area?.closest<HTMLElement>('[data-canale]')?.dataset.canale as IdCorrente | undefined;
      if (!area || !id) return;
      trascinaPotenza = { id, area };
      area.setPointerCapture(e.pointerId);
      impostaIntensita(id, valoreDaY(area, e.clientY));
      e.preventDefault();
    });
    radice.addEventListener('pointermove', (e) => {
      if (trascinaPotenza) impostaIntensita(trascinaPotenza.id, valoreDaY(trascinaPotenza.area, e.clientY));
    });
    for (const ev of ['pointerup', 'pointercancel'] as const) radice.addEventListener(ev, () => (trascinaPotenza = undefined));
    radice.addEventListener(
      'wheel',
      (e) => {
        const area = (e.target as HTMLElement).closest<HTMLElement>('[data-potenza]');
        const id = area?.closest<HTMLElement>('[data-canale]')?.dataset.canale as IdCorrente | undefined;
        if (!id) return;
        e.preventDefault();
        impostaIntensita(id, canali[id].intensita + (e.deltaY < 0 ? 2 : -2));
      },
      { passive: false },
    );
    radice.addEventListener('keydown', (e) => {
      const area = (e.target as HTMLElement).closest<HTMLElement>('[data-potenza]');
      const id = area?.closest<HTMLElement>('[data-canale]')?.dataset.canale as IdCorrente | undefined;
      if (!id) return;
      const passi: Record<string, number> = { ArrowUp: 1, ArrowRight: 1, ArrowDown: -1, ArrowLeft: -1, PageUp: 10, PageDown: -10 };
      if (e.key in passi) {
        e.preventDefault();
        impostaIntensita(id, canali[id].intensita + passi[e.key]);
      } else if (e.key === 'Home' || e.key === 'End') {
        e.preventDefault();
        impostaIntensita(id, e.key === 'Home' ? 0 : 100);
      }
    });

    // ——— tocchi ———
    radice.addEventListener('click', (e) => {
      const t = e.target as Element;
      const vai = t.closest<HTMLElement>('[data-vai]');
      if (vai) return mostra(vai.dataset.vai as 'home' | 'academy' | 'expert');
      const z = t.closest<HTMLElement>('[data-zona]');
      if (z) {
        zona = z.dataset.zona as IdZona;
        posizioni = [];
        clic(1400);
        aggiornaAccessori();
        return passoAcademy(2);
      }
      const f = t.closest<HTMLElement>('[data-fase]');
      if (f) {
        fase = f.dataset.fase as IdFase;
        clic(1400);
        return passoAcademy(3);
      }
      if (t.closest('[data-academy-indietro]')) {
        const visibile = $$('[data-academy-passo]').find((p) => !p.hidden)?.dataset.academyPasso;
        return visibile === '1' ? mostra('home') : passoAcademy(visibile === '3' ? 2 : 1);
      }
      if (t.closest('[data-academy-avvia]')) return caricaProgramma();

      const col = t.closest<HTMLElement>('[data-canale]');
      const id = col?.dataset.canale as IdCorrente | undefined;
      if (id && t.closest('[data-attiva]')) return attiva(id);
      if (id && t.closest('[data-apri-tempo]')) {
        for (const r of $$('[data-regola-tempo]')) r.hidden = r.closest<HTMLElement>('[data-canale]') !== col || !r.hidden;
        scelto = id;
        clic(1300);
        return aggiornaTotale();
      }
      const tempoBtn = t.closest<HTMLElement>('[data-tempo]');
      if (id && tempoBtn) {
        const k = canali[id];
        k.durata = limita(k.durata + Number(tempoBtn.dataset.tempo) * PASSO_DURATA, PASSO_DURATA, DURATA_MAX);
        if (!k.attivo) k.attivo = true;
        clic(1500);
        return aggiornaTotale();
      }
      const ciclaBtn = t.closest<HTMLElement>('[data-cicla]');
      if (id && ciclaBtn) return cicla(id, ciclaBtn.dataset.cicla!);
      const freq = t.closest<HTMLElement>('[data-frequenza]');
      if (id && freq) {
        canali[id].frequenza = freq.dataset.frequenza;
        canali[id].modalita = 'static';
        if (!canali[id].attivo) canali[id].attivo = true;
        if (canali[id].intensita === 0) canali[id].intensita = 30;
        clic(1700);
        aggiornaTotale();
        return aggiornaProfondita();
      }
      if (t.closest('[data-swap]')) {
        swap = !swap;
        if (swap) {
          if (!canali.ret.attivo) attiva('ret', true);
          if (!canali.tens.attivo) attiva('tens', true);
        }
        clic(1900);
        return aggiornaTutto();
      }
      if (t.closest('[data-avvia]')) return avviaSeduta();
      if (t.closest('[data-ferma]')) return ferma();
      if (t.closest('[data-azzera]')) {
        ferma();
        for (const c of CORRENTI) Object.assign(canali[c.id], { attivo: false, intensita: 0, durata: 150 });
        swap = false;
        return aggiornaTutto();
      }
      if (t.closest('[data-impostazioni]')) return void ($('[data-foglio]').hidden = false);
      if (t.closest('[data-chiudi-foglio]')) return void ($('[data-foglio]').hidden = true);
      const acc = t.closest<HTMLElement>('[data-accessorio]');
      if (acc) {
        // dalla barra in basso: piastra sì/no
        if (acc.dataset.accessorio === 'piastra') configurazione = configurazione === 'piastra' ? 'due-tx' : 'piastra';
        else configurazione = configurazione === 'due-tx' ? 'tx-ritorno' : 'due-tx';
        posizioni = [];
        clic(1300);
        return aggiornaAccessori();
      }
      const conf = t.closest<HTMLElement>('[data-configurazione]');
      if (conf) {
        configurazione = conf.dataset.configurazione as IdConfigurazione;
        if (configurazione === 'bracciali' && !canali.ret.attivo) attiva('ret', true);
        posizioni = [];
        return aggiornaAccessori();
      }
      if (t.closest('[data-schermo-intero]')) return void schermoIntero();
    });
    radice.addEventListener('keydown', (e) => {
      const z = (e.target as Element).closest?.('.academy__punto');
      if (z && (e.key === 'Enter' || e.key === ' ')) {
        e.preventDefault();
        (z as HTMLElement).dispatchEvent(new MouseEvent('click', { bubbles: true }));
      }
    });
    radice.addEventListener('change', (e) => {
      const o = (e.target as HTMLInputElement).dataset.opzione as keyof typeof opzioni | undefined;
      if (o) opzioni[o] = (e.target as HTMLInputElement).checked;
    });

    // ——— schermo intero (sul telefono anche in orizzontale) ———
    async function schermoIntero() {
      const d = $('[data-dispositivo]');
      try {
        if (document.fullscreenElement) await document.exitFullscreen();
        else {
          await d.requestFullscreen();
          await (screen.orientation as ScreenOrientation & { lock?: (o: string) => Promise<void> }).lock?.('landscape').catch(() => {});
        }
      } catch {
        // iPhone: niente schermo intero per gli elementi, uso la versione "ingrandita" della pagina
        d.classList.toggle('dispositivo--grande');
      }
    }

    mostra('home');
    aggiornaTutto();
  }
</script>

