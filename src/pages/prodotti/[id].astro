---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icona from '../../components/Icona.astro';
import Condividi from '../../components/Condividi.astro';
import CardProdotto from '../../components/CardProdotto.astro';
import { prodottiPubblicati, type Prodotto } from '../../lib/catalogo';
import { sito, soloCifre, linkWhatsApp, prezzo, statiDisponibilita } from '../../lib/sito';

export async function getStaticPaths() {
  const prodotti = await prodottiPubblicati();
  return prodotti.map((prodotto) => ({ params: { id: prodotto.id }, props: { prodotto, tutti: prodotti } }));
}

interface Props {
  prodotto: Prodotto;
  tutti: Prodotto[];
}

const { prodotto, tutti } = Astro.props;
const { titolo, codice, descrizione_breve, immagini, specifiche, scheda_pdf, documenti, sottocategoria } = prodotto.data;
const prezzoTesto = prezzo(prodotto.data.prezzo);
const { disponibilita } = prodotto.data;
const esaurito = disponibilita === 'esaurito';
const acquistabileOnline = sito.negozio_attivo && !!prodotto.data.prezzo && !esaurito;
const haDescrizione = prodotto.body?.trim().length;
const categoria = await getEntry(prodotto.data.categoria);
const marca = prodotto.data.marca ? await getEntry(prodotto.data.marca) : undefined;
const { Content } = await render(prodotto);

const correlati = tutti
  .filter((p) => p.id !== prodotto.id && p.data.categoria.id === prodotto.data.categoria.id)
  .slice(0, 3);

const nomeCompleto = `${titolo}${codice ? ` (cod. ${codice})` : ''}`;
const richiesta = esaurito
  ? `Buongiorno, vorrei essere avvisato quando torna disponibile: ${nomeCompleto}.`
  : `Buongiorno, vorrei ordinare o ricevere informazioni su: ${nomeCompleto}.`;
const whatsapp = linkWhatsApp(richiesta);
const linkPreventivo = `/contatti/?prodotto=${encodeURIComponent(titolo)}#preventivo`;

const datiStrutturati = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: titolo,
  description: descrizione_breve,
  ...(codice && { sku: codice }),
  ...(immagini.length && { image: immagini.map((i) => new URL(i, Astro.site).toString()) }),
  ...(marca && { brand: { '@type': 'Brand', name: marca.data.nome } }),
  ...(categoria && { category: categoria.data.titolo }),
  ...(prodotto.data.prezzo && {
    offers: {
      '@type': 'Offer',
      price: prodotto.data.prezzo.toFixed(2),
      priceCurrency: 'EUR',
      availability: statiDisponibilita[disponibilita].schema,
      priceSpecification: { '@type': 'PriceSpecification', valueAddedTaxIncluded: false },
    },
  }),
};
---

<Base titolo={titolo} descrizione={descrizione_breve} immagine={immagini[0]} tipo="product" datiStrutturati={datiStrutturati}>
  <section class="scheda">
    <div class="contenitore">
      <nav aria-label="Percorso" class="briciole">
        <a href="/prodotti/"><Icona nome="frecciaSinistra" dimensione={16} /> Catalogo</a>
        {categoria && <a href={`/categorie/${categoria.id}/`}>{categoria.data.titolo}</a>}
      </nav>

      <div class="scheda__griglia">
        <div class="galleria" data-galleria>
          <div class="galleria__principale">
            {
              immagini.length > 0 ? (
                <img src={immagini[0]} alt={titolo} data-principale />
              ) : (
                <div class="galleria__segnaposto">
                  <Icona nome={categoria?.data.icona ?? 'immagine'} dimensione={72} />
                  <span>Immagine in arrivo</span>
                </div>
              )
            }
          </div>
          {
            immagini.length > 1 && (
              <ul class="galleria__miniature">
                {immagini.map((src, i) => (
                  <li>
                    <button type="button" data-miniatura={src} aria-current={i === 0 ? 'true' : undefined}>
                      <img src={src} alt={`${titolo} – immagine ${i + 1}`} loading="lazy" />
                    </button>
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        <div class="scheda__info">
          <div class="scheda__etichette">
            {categoria && <a class="etichetta" href={`/categorie/${categoria.id}/`}>{categoria.data.titolo}</a>}
            {sottocategoria && <span class="etichetta">{sottocategoria}</span>}
            {marca && <span class="etichetta etichetta--accento">{marca.data.nome}</span>}
          </div>
          <h1>{titolo}</h1>
          {codice && <p class="scheda__codice">Codice: {codice}</p>}
          <p class="scheda__breve">{descrizione_breve}</p>

          <p class:list={['scheda__stato', `scheda__stato--${disponibilita}`]}>
            <span></span>
            {statiDisponibilita[disponibilita].etichetta}
            {disponibilita === 'esaurito' && ' – momentaneamente non ordinabile'}
            {disponibilita === 'su_ordinazione' && ' – chiedici i tempi di consegna'}
          </p>

          <div class="scheda__prezzo">
            {
              prezzoTesto ? (
                <>
                  <strong>{prezzoTesto}</strong>
                  <span>+ IVA</span>
                </>
              ) : (
                <strong class="scheda__prezzo--richiesta">Prezzo su richiesta</strong>
              )
            }
          </div>

          {
            acquistabileOnline && (
              <form class="acquisto" data-acquisto={prodotto.id} onsubmit="return false">
                <div class="quantita" role="group" aria-label="Quantità">
                  <button type="button" data-meno aria-label="Diminuisci la quantità">
                    <Icona nome="meno" dimensione={18} />
                  </button>
                  <input type="number" name="quantita" value="1" min="1" max="99" inputmode="numeric" aria-label="Quantità" />
                  <button type="button" data-piu aria-label="Aumenta la quantità">
                    <Icona nome="piu" dimensione={18} />
                  </button>
                </div>
                <button class="pulsante pulsante--primario acquisto__aggiungi" type="submit">
                  <Icona nome="carrello" /> Aggiungi al carrello
                </button>
                <p class="acquisto__avviso" role="status" data-avviso hidden>
                  <Icona nome="spunta" dimensione={18} /> Aggiunto al carrello · <a href="/carrello/">Vai al carrello</a>
                </p>
                <p class="acquisto__pagamenti">
                  <Icona nome="lucchetto" dimensione={16} /> Pagamento sicuro con carta, PayPal, Apple Pay e Google Pay
                </p>
              </form>
            )
          }

          <div class="scheda__azioni">
            {
              whatsapp && (
                <a
                  class:list={['pulsante', acquistabileOnline ? 'pulsante--contorno' : 'pulsante--whatsapp']}
                  href={whatsapp}
                  target="_blank"
                  rel="noopener"
                >
                  <Icona nome="whatsapp" /> {esaurito ? 'Avvisami su WhatsApp' : 'Ordina su WhatsApp'}
                </a>
              )
            }
            <a class="pulsante pulsante--contorno" href={linkPreventivo}>Richiedi informazioni</a>
            {
              !whatsapp && sito.telefono && (
                <a class="pulsante pulsante--contorno" href={`tel:${soloCifre(sito.telefono)}`}>
                  <Icona nome="telefono" /> Chiama
                </a>
              )
            }
          </div>

          {
            scheda_pdf && (
              <a class="scheda__pdf" href={scheda_pdf} target="_blank" rel="noopener">
                <Icona nome="documento" />
                <span>
                  <strong>Scheda tecnica</strong>
                  <small>Scarica il PDF</small>
                </span>
              </a>
            )
          }
          {
            documenti.map((d) => (
              <a class="scheda__pdf" href={d.file} target="_blank" rel="noopener">
                <Icona nome="documento" />
                <span>
                  <strong>{d.titolo}</strong>
                  <small>Scarica il PDF</small>
                </span>
              </a>
            ))
          }

          <ul class="scheda__garanzie">
            <li><Icona nome="scudo" dimensione={20} /> Dispositivo certificato</li>
            <li><Icona nome="persone" dimensione={20} /> Consulenza prima dell’acquisto</li>
          </ul>

          <Condividi titolo={titolo} />
        </div>
      </div>
    </div>
  </section>

  {
    (haDescrizione || specifiche.length > 0) && (
      <section class="sezione dettagli">
        <div class="contenitore dettagli__griglia">
          {
            haDescrizione ? (
              <div>
                <h2>Descrizione</h2>
                <div class="prosa">
                  <Content />
                </div>
              </div>
            ) : null
          }
          {
            specifiche.length > 0 && (
              <div>
                <h2>Specifiche tecniche</h2>
                <table class="specifiche">
                  <tbody>
                    {specifiche.map((s) => (
                      <tr>
                        <th scope="row">{s.nome}</th>
                        <td>{s.valore}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )
          }
        </div>
      </section>
    )
  }

  {
    correlati.length > 0 && (
      <section class="sezione sezione--chiara">
        <div class="contenitore">
          <h2>Altri prodotti in {categoria?.data.titolo}</h2>
          <div class="griglia griglia--prodotti correlati">
            {correlati.map((p) => (
              <CardProdotto prodotto={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<script>
  import { aggiungi } from '../../lib/carrello';

  document.querySelectorAll<HTMLFormElement>('[data-acquisto]').forEach((modulo) => {
    const campo = modulo.querySelector<HTMLInputElement>('input[name="quantita"]')!;
    const avviso = modulo.querySelector<HTMLElement>('[data-avviso]');
    const leggi = () => Math.min(99, Math.max(1, Math.floor(Number(campo.value)) || 1));
    modulo.querySelector('[data-meno]')?.addEventListener('click', () => (campo.value = String(Math.max(1, leggi() - 1))));
    modulo.querySelector('[data-piu]')?.addEventListener('click', () => (campo.value = String(Math.min(99, leggi() + 1))));
    modulo.addEventListener('submit', () => {
      aggiungi(modulo.dataset.acquisto!, leggi());
      campo.value = '1';
      if (avviso) avviso.hidden = false;
    });
  });

  document.querySelectorAll<HTMLElement>('[data-galleria]').forEach((galleria) => {
    const principale = galleria.querySelector<HTMLImageElement>('[data-principale]');
    const miniature = galleria.querySelectorAll<HTMLButtonElement>('[data-miniatura]');
    miniature.forEach((bottone) =>
      bottone.addEventListener('click', () => {
        if (principale && bottone.dataset.miniatura) principale.src = bottone.dataset.miniatura;
        miniature.forEach((b) => b.removeAttribute('aria-current'));
        bottone.setAttribute('aria-current', 'true');
      }),
    );
  });
</script>

<style>
  .scheda {
    padding-block: 32px clamp(40px, 6vw, 72px);
    background: linear-gradient(180deg, var(--blu-50), var(--bianco) 70%);
  }

  .briciole {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-bottom: 28px;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .briciole a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--grigio-500);
    text-decoration: none;
  }

  .briciole a:hover {
    color: var(--blu-700);
  }

  .scheda__griglia {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }

  .galleria__principale {
    aspect-ratio: 1;
    border-radius: 24px;
    background: var(--bianco);
    border: 1px solid var(--grigio-200);
    overflow: hidden;
  }

  .galleria__principale img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: clamp(16px, 4vw, 40px);
  }

  .galleria__segnaposto {
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--blu-600);
    background: linear-gradient(135deg, var(--blu-50), var(--accento-chiaro));
    font-weight: 600;
  }

  .galleria__miniature {
    display: flex;
    gap: 10px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
  }

  .galleria__miniature button {
    width: 80px;
    height: 80px;
    padding: 6px;
    border-radius: 12px;
    border: 2px solid var(--grigio-200);
    background: var(--bianco);
    cursor: pointer;
  }

  .galleria__miniature button[aria-current='true'] {
    border-color: var(--accento);
  }

  .galleria__miniature img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .scheda__etichette {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .scheda__etichette a {
    text-decoration: none;
  }

  .scheda__info h1 {
    font-size: clamp(1.9rem, 3.6vw, 2.7rem);
    margin-bottom: 8px;
  }

  .scheda__codice {
    font-size: 0.92rem;
    color: var(--grigio-500);
    font-variant-numeric: tabular-nums;
  }

  .scheda__breve {
    font-size: 1.12rem;
    color: var(--grigio-700);
    margin-bottom: 28px;
  }

  .scheda__stato {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
    font-size: 0.95rem;
    font-weight: 700;
    color: #067647;
  }

  .scheda__stato span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: currentColor;
  }

  .scheda__stato--su_ordinazione {
    color: var(--blu-700);
  }

  .scheda__stato--esaurito {
    color: #b42318;
  }

  .scheda__prezzo {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 24px;
  }

  .scheda__prezzo strong {
    font-size: 2.1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--blu-900);
    font-variant-numeric: tabular-nums;
  }

  .scheda__prezzo span {
    font-weight: 600;
    color: var(--grigio-500);
  }

  .scheda__prezzo .scheda__prezzo--richiesta {
    font-size: 1.4rem;
    color: var(--accento-testo);
  }

  .acquisto {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 16px;
  }

  .quantita {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--grigio-300);
    border-radius: 999px;
    background: var(--bianco);
  }

  .quantita button {
    display: inline-flex;
    width: 46px;
    height: 50px;
    align-items: center;
    justify-content: center;
    border: 0;
    background: none;
    color: var(--blu-900);
    cursor: pointer;
  }

  .quantita input {
    width: 44px;
    border: 0;
    font: inherit;
    font-weight: 700;
    text-align: center;
    background: none;
    -moz-appearance: textfield;
  }

  .quantita input::-webkit-inner-spin-button,
  .quantita input::-webkit-outer-spin-button {
    -webkit-appearance: none;
  }

  .acquisto__aggiungi {
    flex: 1 1 220px;
  }

  .acquisto__avviso,
  .acquisto__pagamenti {
    flex-basis: 100%;
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    font-size: 0.9rem;
    color: var(--grigio-500);
  }

  .acquisto__avviso {
    font-weight: 700;
    color: #067647;
  }

  .scheda__azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }

  .scheda__pdf {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    margin-bottom: 24px;
    border-radius: 16px;
    border: 1px dashed var(--grigio-300);
    color: var(--blu-800);
    text-decoration: none;
  }

  .scheda__pdf:hover {
    border-color: var(--blu-600);
    background: var(--blu-50);
  }

  .scheda__pdf strong,
  .scheda__pdf small {
    display: block;
  }

  .scheda__pdf small {
    color: var(--grigio-500);
  }

  .scheda__garanzie {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    list-style: none;
    padding: 20px 0;
    margin: 0 0 20px;
    border-block: 1px solid var(--grigio-200);
    font-size: 0.93rem;
    font-weight: 600;
    color: var(--grigio-700);
  }

  .scheda__garanzie li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .scheda__garanzie svg {
    color: var(--accento-testo);
  }

  .dettagli {
    padding-top: 0;
  }

  .dettagli__griglia {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(32px, 5vw, 64px);
  }

  .dettagli h2 {
    font-size: 1.6rem;
  }

  .specifiche {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.97rem;
    border-radius: var(--raggio);
    overflow: hidden;
    border: 1px solid var(--grigio-200);
  }

  .specifiche th,
  .specifiche td {
    padding: 14px 18px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--grigio-200);
  }

  .specifiche tr:last-child th,
  .specifiche tr:last-child td {
    border-bottom: 0;
  }

  .specifiche th {
    width: 42%;
    font-weight: 600;
    color: var(--grigio-700);
    background: var(--grigio-100);
  }

  .correlati {
    margin-top: 32px;
  }

  @media (max-width: 860px) {
    .scheda__griglia,
    .dettagli__griglia {
      grid-template-columns: 1fr;
    }
  }
</style>
