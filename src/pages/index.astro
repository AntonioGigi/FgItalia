---
import Base from '../layouts/Base.astro';
import Icona from '../components/Icona.astro';
import CardCategoria from '../components/CardCategoria.astro';
import CardProdotto from '../components/CardProdotto.astro';
import SezioneSocial from '../components/SezioneSocial.astro';
import InvitoContatto from '../components/InvitoContatto.astro';
import IscrizioneAvvisi from '../components/IscrizioneAvvisi.astro';
import { categorieOrdinate, marchiOrdinati, prodottiPubblicati, novitaPubblicate } from '../lib/catalogo';
import { sito, anniAttivita, formatoData, linkWhatsApp } from '../lib/sito';

const categorie = await categorieOrdinate();
const marchi = await marchiOrdinati();
const prodotti = await prodottiPubblicati();
const inEvidenza = prodotti.filter((p) => p.data.in_evidenza).slice(0, 6);
const novita = (await novitaPubblicate()).slice(0, 3);
const contaPerCategoria = (id: string) => prodotti.filter((p) => p.data.categoria.id === id).length;
const whatsapp = linkWhatsApp('Buongiorno, vorrei informazioni sui vostri prodotti.');

const punti = [
  {
    icona: 'scudo',
    titolo: 'Prodotti certificati',
    testo: 'Apparecchiature dotate delle certificazioni necessarie, da produttori selezionati come Globus ed EME.',
  },
  {
    icona: 'persone',
    titolo: 'Consulenza diretta',
    testo: 'Parli con chi conosce davvero i prodotti: ti aiutiamo a scegliere in base al tuo lavoro.',
  },
  {
    icona: 'camion',
    titolo: 'Spedizioni in tutta Italia',
    testo: 'Dalla Sicilia a tutta Italia: dal singolo consumabile all’allestimento completo dello studio.',
  },
  {
    icona: 'chiave',
    titolo: 'Assistenza post-vendita',
    testo: 'Supporto prima e dopo l’acquisto e tutti i materiali di consumo per le tue apparecchiature.',
  },
] as const;
---

<Base>
  <section class="hero">
    <div class="contenitore hero__griglia">
      <div class="hero__testo">
        <span class="hero__badge"><span></span> Dal {sito.anno_fondazione} ad {sito.citta} · Spedizioni in tutta Italia</span>
        <h1>{sito.hero_titolo}</h1>
        <p>{sito.hero_testo}</p>
        <div class="hero__azioni">
          <a class="pulsante pulsante--primario" href="/prodotti/">Scopri il catalogo <Icona nome="freccia" /></a>
          {
            whatsapp ? (
              <a class="pulsante pulsante--whatsapp" href={whatsapp} target="_blank" rel="noopener">
                <Icona nome="whatsapp" /> Scrivici su WhatsApp
              </a>
            ) : (
              <a class="pulsante pulsante--chiaro" href="/contatti/#preventivo">
                Richiedi un preventivo
              </a>
            )
          }
        </div>
      </div>

      <div class="hero__visuale">
        <figure class="hero__foto">
          <img src="/uploads/foto/showroom.webp" alt={`Lo showroom ${sito.nome_breve} ad ${sito.citta}`} width="700" height="1050" />
        </figure>
        <div class="hero__carta hero__carta--1">
          <Icona nome="scudo" />
          <div><strong>Prodotti certificati</strong><small>Apparecchiature a norma CE</small></div>
        </div>
        <div class="hero__carta hero__carta--2">
          <strong>{anniAttivita}+</strong>
          <small>anni di esperienza</small>
        </div>
      </div>
    </div>
  </section>

  <section class="marchi" aria-label="Marchi trattati">
    <div class="contenitore marchi__riga">
      <span class="marchi__etichetta">Marchi trattati</span>
      <ul>
        {marchi.map((m) => <li>{m.data.logo ? <img src={m.data.logo} alt={m.data.nome} loading="lazy" /> : m.data.nome}</li>)}
      </ul>
    </div>
  </section>

  <section class="sezione">
    <div class="contenitore">
      <div class="sezione__testa appare">
        <span class="sopratitolo">Il nostro catalogo</span>
        <h2>Tutto ciò che serve al tuo studio, in un unico fornitore</h2>
        <p class="testo-intro">
          Apparecchiature elettromedicali, strumenti per la terapia manuale e materiali di consumo per
          fisioterapisti, studi, centri di riabilitazione e strutture sanitarie.
        </p>
      </div>
      <div class="griglia griglia--categorie">
        {categorie.map((c) => <CardCategoria categoria={c} numero={contaPerCategoria(c.id)} />)}
      </div>
    </div>
  </section>

  {
    inEvidenza.length > 0 && (
      <section class="sezione sezione--chiara">
        <div class="contenitore">
          <div class="riga-testa appare">
            <div>
              <span class="sopratitolo">In evidenza</span>
              <h2>Prodotti consigliati</h2>
            </div>
            <a class="pulsante pulsante--contorno" href="/prodotti/">
              Vedi tutti <Icona nome="freccia" />
            </a>
          </div>
          <div class="griglia griglia--prodotti">
            {inEvidenza.map((p) => (
              <CardProdotto prodotto={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="sezione">
    <div class="contenitore perche">
      <div class="perche__intro appare">
        <span class="sopratitolo">Perché sceglierci</span>
        <h2>Un partner di fiducia, non un semplice fornitore</h2>
        <p class="testo-intro">
          Dal {sito.anno_fondazione} accompagniamo fisioterapisti e strutture sanitarie nella scelta delle attrezzature,
          con consulenza personalizzata e la serietà di un’azienda del territorio.
        </p>
        <dl class="numeri">
          <div><dt>Anni di attività</dt><dd>{anniAttivita}+</dd></div>
          <div><dt>Prodotti a catalogo</dt><dd>{prodotti.length}</dd></div>
          <div><dt>Schede tecniche</dt><dd>{prodotti.filter((p) => p.data.scheda_pdf).length}</dd></div>
        </dl>
      </div>
      <ul class="perche__punti">
        {
          punti.map((p) => (
            <li class="appare">
              <span>
                <Icona nome={p.icona} />
              </span>
              <h3>{p.titolo}</h3>
              <p>{p.testo}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <SezioneSocial />

  {
    novita.length > 0 && (
      <section class="sezione sezione--chiara">
        <div class="contenitore">
          <div class="riga-testa appare">
            <div>
              <span class="sopratitolo">Novità e offerte</span>
              <h2>Dal nostro magazzino</h2>
            </div>
            <a class="pulsante pulsante--contorno" href="/novita/">
              Tutte le novità <Icona nome="freccia" />
            </a>
          </div>
          <div class="griglia">
            {novita.map((n) => (
              <a class="card-novita appare" href={`/novita/${n.id}/`}>
                {n.data.immagine && <img src={n.data.immagine} alt="" loading="lazy" />}
                <div>
                  <time datetime={n.data.data.toISOString()}>{formatoData.format(n.data.data)}</time>
                  <h3>{n.data.titolo}</h3>
                  <p>{n.data.riassunto}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="contenitore iscrizione">
    <IscrizioneAvvisi />
  </section>

  <InvitoContatto />
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(48px, 8vw, 104px) clamp(56px, 9vw, 120px);
    background:
      radial-gradient(circle at 85% 20%, rgb(96 152 248 / 0.28), transparent 40%),
      radial-gradient(circle at 10% 110%, rgb(0 48 152 / 0.5), transparent 45%),
      var(--blu-900);
    color: rgb(255 255 255 / 0.78);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(180deg, black, transparent 85%);
  }

  .hero__griglia {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: clamp(40px, 6vw, 80px);
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px 6px 10px;
    margin-bottom: 24px;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.15);
    background: rgb(255 255 255 / 0.06);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--bianco);
  }

  .hero__badge span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accento);
    box-shadow: 0 0 0 4px rgb(248 200 0 / 0.25);
  }

  .hero h1 {
    color: var(--bianco);
    margin-bottom: 20px;
  }

  .hero__testo p {
    font-size: 1.15rem;
    max-width: 54ch;
    margin-bottom: 32px;
  }

  .hero__azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__visuale {
    position: relative;
    padding: 40px 0 40px 24px;
  }

  .hero__foto {
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: 28px;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.12);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.35);
  }

  .hero__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__carta {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-radius: 16px;
    background: var(--bianco);
    color: var(--blu-900);
    box-shadow: var(--ombra-forte);
    animation: fluttua 6s ease-in-out infinite;
  }

  .hero__carta svg {
    color: var(--accento-testo);
  }

  .hero__carta strong {
    display: block;
    line-height: 1.2;
  }

  .hero__carta small {
    color: var(--grigio-500);
  }

  .hero__carta--1 {
    left: -8px;
    bottom: 0;
  }

  .hero__carta--2 {
    right: -12px;
    top: 0;
    flex-direction: column;
    gap: 0;
    animation-delay: -3s;
  }

  .hero__carta--2 strong {
    font-size: 2rem;
    color: var(--accento-testo);
  }

  @keyframes fluttua {
    50% {
      transform: translateY(-8px);
    }
  }

  .marchi {
    border-bottom: 1px solid var(--grigio-200);
  }

  .marchi__riga {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 40px;
    padding-block: 28px;
  }

  .marchi__etichetta {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--grigio-500);
  }

  .marchi ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 40px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .marchi li {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--grigio-500);
  }

  .marchi img {
    height: 32px;
    width: auto;
    filter: grayscale(1);
    opacity: 0.6;
  }

  .iscrizione {
    margin-top: clamp(56px, 9vw, 112px);
  }

  .griglia--categorie {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }

  .riga-testa {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 32px;
    margin-bottom: 40px;
  }

  .riga-testa h2 {
    margin: 0;
  }

  .perche {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: start;
  }

  .perche__intro {
    position: sticky;
    top: 110px;
  }

  .numeri {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 32px 0 0;
  }

  .numeri div {
    display: flex;
    flex-direction: column-reverse;
    padding-top: 16px;
    border-top: 2px solid var(--grigio-200);
  }

  .numeri dt {
    font-size: 0.88rem;
    color: var(--grigio-500);
  }

  .numeri dd {
    margin: 0;
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--blu-900);
  }

  .perche__punti {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .perche__punti li {
    padding: 28px;
    border-radius: var(--raggio);
    background: var(--blu-50);
  }

  .perche__punti li:nth-child(even) {
    transform: translateY(32px);
  }

  .perche__punti li:nth-child(even).appare:not(.visibile) {
    transform: translateY(50px);
  }

  .perche__punti span {
    display: inline-flex;
    width: 52px;
    height: 52px;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: var(--bianco);
    color: var(--accento-testo);
    box-shadow: var(--ombra);
    margin-bottom: 18px;
  }

  .perche__punti p {
    margin: 0;
    font-size: 0.97rem;
    color: var(--grigio-700);
  }

  .card-novita {
    display: flex;
    flex-direction: column;
    border-radius: var(--raggio);
    background: var(--bianco);
    border: 1px solid var(--grigio-200);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .card-novita:hover {
    transform: translateY(-4px);
    box-shadow: var(--ombra-forte);
    color: inherit;
  }

  .card-novita img {
    aspect-ratio: 16 / 9;
    object-fit: cover;
    width: 100%;
  }

  .card-novita div {
    padding: 24px;
  }

  .card-novita time {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accento-testo);
  }

  .card-novita h3 {
    margin-top: 6px;
  }

  .card-novita p {
    margin: 0;
    color: var(--grigio-500);
    font-size: 0.97rem;
  }

  @media (max-width: 900px) {
    .hero__griglia,
    .perche {
      grid-template-columns: 1fr;
    }

    .hero__visuale {
      padding: 32px 8px;
      max-width: 520px;
    }

    .hero__foto {
      aspect-ratio: 4 / 3;
    }

    .perche__intro {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .perche__punti {
      grid-template-columns: 1fr;
    }

    .perche__punti li:nth-child(even) {
      transform: none;
    }

    .hero__carta--2 {
      right: 0;
    }

    .hero__carta--1 {
      left: 0;
    }

    .numeri dd {
      font-size: 1.7rem;
    }
  }
</style>
