---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icona from '../components/Icona.astro';
import { sito, linkWhatsApp, urlFacebook, urlInstagram } from '../lib/sito';

interface Props {
  titolo?: string;
  descrizione?: string;
  immagine?: string;
  tipo?: 'website' | 'article' | 'product';
  datiStrutturati?: Record<string, unknown>;
  /** nasconde il pulsante WhatsApp fisso (pagine che hanno già i loro pulsanti) */
  senzaWhatsapp?: boolean;
}

const {
  titolo,
  descrizione = `${sito.ragione_sociale}: ${sito.slogan.toLowerCase()} ad ${sito.citta}. Monitoraggio, diagnostica, fisioterapia, riabilitazione e materiale di consumo.`,
  immagine = '/img/condivisione.png',
  tipo = 'website',
  datiStrutturati,
  senzaWhatsapp = false,
} = Astro.props;

const titoloCompleto = titolo ? `${titolo} | ${sito.nome_breve}` : `${sito.nome_breve} – ${sito.slogan}`;
const canonico = new URL(Astro.url.pathname, Astro.site);
const immagineAssoluta = new URL(immagine, Astro.site);
const whatsapp = linkWhatsApp('Buongiorno, vi contatto dal sito web.');

const sameAs = [urlInstagram(), urlFacebook()].filter(Boolean);
const azienda = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  name: sito.ragione_sociale,
  url: Astro.site?.toString(),
  vatID: `IT${sito.piva}`,
  foundingDate: String(sito.anno_fondazione),
  address: {
    '@type': 'PostalAddress',
    streetAddress: sito.indirizzo,
    postalCode: sito.cap,
    addressLocality: sito.citta,
    addressRegion: sito.provincia,
    addressCountry: 'IT',
  },
  ...(sito.telefono && { telephone: sito.telefono }),
  ...(sito.email && { email: sito.email }),
  ...(sameAs.length && { sameAs }),
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloCompleto}</title>
    <meta name="description" content={descrizione} />
    <link rel="canonical" href={canonico} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#08163f" />

    <meta property="og:type" content={tipo === 'article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={sito.nome_breve} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={titolo ?? titoloCompleto} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:url" content={canonico} />
    <meta property="og:image" content={immagineAssoluta} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(azienda)} />
    {datiStrutturati && <script type="application/ld+json" set:html={JSON.stringify(datiStrutturati)} />}
  </head>
  <body>
    <a class="vai-al-contenuto" href="#contenuto">Vai al contenuto</a>
    <Header />
    <main id="contenuto">
      <slot />
    </main>
    <Footer />

    {
      whatsapp && !senzaWhatsapp && (
        <a class="whatsapp-fisso" href={whatsapp} target="_blank" rel="noopener" aria-label="Scrivici su WhatsApp">
          <Icona nome="whatsapp" dimensione={28} />
        </a>
      )
    }

    <script>
      const elementi = document.querySelectorAll('.appare');
      if ('IntersectionObserver' in window) {
        const osservatore = new IntersectionObserver(
          (voci) => {
            for (const voce of voci) {
              if (voce.isIntersecting) {
                voce.target.classList.add('visibile');
                osservatore.unobserve(voce.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        elementi.forEach((el) => osservatore.observe(el));
      } else {
        elementi.forEach((el) => el.classList.add('visibile'));
      }
    </script>

    <style>
      .whatsapp-fisso {
        position: fixed;
        right: 20px;
        bottom: 20px;
        z-index: 40;
        display: flex;
        width: 60px;
        height: 60px;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: var(--whatsapp);
        color: var(--bianco);
        box-shadow: 0 10px 30px rgb(31 168 85 / 0.45);
        transition: transform 0.15s ease;
      }

      .whatsapp-fisso:hover {
        transform: scale(1.06);
        color: var(--bianco);
      }
    </style>
  </body>
</html>
